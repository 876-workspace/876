{
  "name": "@876/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:sw && next dev --turbopack --port 3000",
    "build:sw": "node scripts/build-sw.mjs",
    "build": "pnpm build:next",
    "build:next": "pnpm build:sw && NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start --port ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo .open-next .wrangler",
    "cf:build": "pnpm build:sw && opennextjs-cloudflare build",
    "preview": "pnpm build:sw && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm build:sw && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "pnpm build:sw && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@876/analytics": "workspace:*",
    "@876/client": "workspace:*",
    "@876/core": "workspace:*",
    "@876/sdk": "workspace:*",
    "@876/types": "workspace:*",
    "@876/ui": "workspace:*",
    "@opennextjs/cloudflare": "1.20.2",
    "@sentry/nextjs": "10.56.0",
    "@tanstack/react-form": "1.33.5",
    "@workos-inc/node": "10.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "iron-session": "8.0.4",
    "next": "16.3.1",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "9.5.12",
    "sonner": "2.0.8",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@serwist/turbopack": "9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
