{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "876-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "876-app",
    },
  ],
  // Non-secret service URLs. Secrets are set with `wrangler secret put`.
  "vars": {
    "API_URL": "https://876-api.raheemforschool.workers.dev",
    "SENTRY_DSN": "https://da40e44586268d1c33e81b0520c10f55@o4507681618591744.ingest.us.sentry.io/4511802775830528",
    "NEXT_PUBLIC_SENTRY_DSN": "https://da40e44586268d1c33e81b0520c10f55@o4507681618591744.ingest.us.sentry.io/4511802775830528",
  },
  "observability": {
    "enabled": true,
  },
}
