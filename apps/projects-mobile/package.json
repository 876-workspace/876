{
  "name": "@876/projects-mobile",
  "version": "0.1.0",
  "description": "876 Projects native mobile app (Expo, Android-first).",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "expo-doctor": "expo-doctor"
  },
  "dependencies": {
    "@876/projects": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.103.1",
    "expo": "~57.0.23",
    "expo-auth-session": "57.0.12",
    "expo-constants": "57.0.18",
    "expo-dev-client": "57.0.19",
    "expo-linking": "57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "~19.2.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
