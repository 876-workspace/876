# Public OAuth client identifier for the native app, seeded by Core
# (`pnpm --filter @876/api seed` registers `876_projects_mobile` as a
# first-party public client). This is a public identifier, not a secret —
# the app holds no client secret by design (PKCE public-client flow).
EXPO_PUBLIC_OAUTH_CLIENT_ID=876_projects_mobile

# Public Core/OAuth issuer origin. Defaults to production when unset.
# optional — defaults to https://api.876.app
EXPO_PUBLIC_OAUTH_ISSUER=

# First-party web authorize proxy that signs the user in and drives Core
# /oauth/authorize server-side, then redirects to the native scheme callback.
# Required — the app fails loudly at startup when unset (no silent fallback).
# Production: https://enterprise.876.app/api/oauth/native-authorize
EXPO_PUBLIC_876_AUTHORIZE_URL=
