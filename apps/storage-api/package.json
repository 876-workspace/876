{
  "name": "@876/storage-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": ".venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 4005 --reload --reload-include '.env' --reload-include '.env.*'",
    "build": "[ -x .venv/bin/python ] && .venv/bin/python -m compileall -q . || echo 'skip storage api build (no venv)'",
    "start": ".venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port ${PORT:-4005}",
    "typecheck": ".venv/bin/python -m mypy .",
    "test": ".venv/bin/python -m pytest",
    "lint": ".venv/bin/python -m ruff check .",
    "format": ".venv/bin/python -m ruff format .",
    "format:check": ".venv/bin/python -m ruff format --check .",
    "db:migrate": ".venv/bin/python -m alembic upgrade head",
    "storage:check": ".venv/bin/python -m scripts.check_storage",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "typescript": "5.9.3",
    "wrangler": "4.113.0"
  }
}
