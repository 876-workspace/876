/// Transactional event envelope for stable Billing integration events.
model OutboxEvent {
  id           String  @id
  tenantId     String  @map("tenant_id")
  type         String
  version      Int     @default(1)
  resourceType String  @map("resource_type")
  resourceId   String  @map("resource_id")
  payload      Json
  occurredAt   Int     @map("occurred_at")
  publishedAt  Int?    @map("published_at")
  attemptCount Int     @default(0) @map("attempt_count")
  lastError    String? @map("last_error")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_outbox_events_tenant_id_fkey")

  @@index([tenantId, occurredAt], map: "billing_outbox_events_tenant_occurred_idx")
  @@index([publishedAt, occurredAt], map: "billing_outbox_events_publish_idx")
  @@map("billing_outbox_events")
}
