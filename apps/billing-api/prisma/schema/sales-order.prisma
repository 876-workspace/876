enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELED

  @@map("BillingSalesOrderStatus")
}

/// A tenant-owned commercial commitment. Financial settlement is represented
/// by linked Invoices/Payments and operational fulfillment remains a future
/// domain; neither is persisted as mutable Sales Order status.
model SalesOrder {
  id                      String           @id
  tenantId                String           @map("tenant_id")
  sourceAppId             String?          @map("source_app_id")
  sourceExternalReference String?          @map("source_external_reference")
  sourceIdempotencyKey    String?          @map("source_idempotency_key")
  sourcePayloadHash       String?          @map("source_payload_hash")
  customerId              String           @map("customer_id")
  priceListId             String?          @map("price_list_id")
  priceListName           String?          @map("price_list_name")
  quoteId                 String?          @unique @map("quote_id")
  salespersonId           String?          @map("salesperson_id")
  number                  String
  status                  SalesOrderStatus @default(DRAFT)
  currency                String
  referenceNumber         String?          @map("reference_number")
  taxBehavior             TaxBehavior      @default(EXCLUSIVE) @map("tax_behavior")
  customerName            String?          @map("customer_name")
  customerEmail           String?          @map("customer_email")
  billingAddressSnapshot  Json?            @map("billing_address_snapshot")
  shippingAddressSnapshot Json?            @map("shipping_address_snapshot")
  orderedAt               Int              @map("ordered_at")
  confirmedAt             Int?             @map("confirmed_at")
  completedAt             Int?             @map("completed_at")
  canceledAt              Int?             @map("canceled_at")
  subtotalAmount          BigInt           @default(0) @map("subtotal_amount")
  taxAmount               BigInt           @default(0) @map("tax_amount")
  discountAmount          BigInt           @default(0) @map("discount_amount")
  totalAmount             BigInt           @default(0) @map("total_amount")
  salespersonName         String?          @map("salesperson_name")
  notes                   String?
  terms                   String?
  metadata                Json?
  createdAt               Int              @map("created_at")
  updatedAt               Int              @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_sales_orders_tenant_id_fkey")
  customer    Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "billing_sales_orders_customer_fkey")
  priceList   PriceList?   @relation(fields: [tenantId, priceListId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "billing_sales_orders_price_list_fkey")
  quote       Quote?       @relation("QuoteConvertedSalesOrder", fields: [quoteId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "billing_sales_orders_quote_id_fkey")
  salesperson Salesperson? @relation(fields: [tenantId, salespersonId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "billing_sales_orders_salesperson_fkey")
  lines       SalesOrderLine[]
  invoices    Invoice[]    @relation("SalesOrderInvoices")

  @@unique([tenantId, id], map: "billing_sales_orders_tenant_id_id_key")
  @@unique([tenantId, number], name: "billing_sales_orders_tenant_id_number_key", map: "billing_sales_orders_tenant_id_number_key")
  @@unique([tenantId, sourceAppId, sourceExternalReference], name: "billing_sales_orders_source_external_key", map: "billing_sales_orders_source_external_key")
  @@unique([tenantId, sourceAppId, sourceIdempotencyKey], name: "billing_sales_orders_source_idempotency_key", map: "billing_sales_orders_source_idempotency_key")
  @@index([tenantId, status, orderedAt], map: "billing_sales_orders_tenant_status_ordered_at_idx")
  @@index([tenantId, customerId, orderedAt], map: "billing_sales_orders_tenant_customer_ordered_at_idx")
  @@index([tenantId, sourceAppId], map: "billing_sales_orders_source_app_idx")
  @@index([priceListId], map: "billing_sales_orders_price_list_id_idx")
  @@index([salespersonId], map: "billing_sales_orders_salesperson_id_idx")
  @@map("billing_sales_orders")
}

/// Immutable catalog, pricing and tax snapshot captured on a Sales Order line.
model SalesOrderLine {
  id             String   @id
  salesOrderId   String   @map("sales_order_id")
  itemId         String?  @map("item_id")
  variantId      String?  @map("variant_id")
  variantName    String?  @map("variant_name")
  variantSku     String?  @map("variant_sku")
  priceId        String?  @map("price_id")
  taxRateId      String?  @map("tax_rate_id")
  description    String
  unit           String?
  position       Int      @default(0)
  quantity       Int      @default(1)
  unitAmount     BigInt   @map("unit_amount")
  taxAmount      BigInt   @default(0) @map("tax_amount")
  taxName        String?  @map("tax_name")
  taxRate        Decimal? @map("tax_rate") @db.Decimal(7, 4)
  taxInclusive   Boolean  @default(false) @map("tax_inclusive")
  discountAmount BigInt   @default(0) @map("discount_amount")
  totalAmount    BigInt   @map("total_amount")
  createdAt      Int      @map("created_at")
  updatedAt      Int      @map("updated_at")

  salesOrder   SalesOrder   @relation(fields: [salesOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_sales_order_lines_sales_order_id_fkey")
  item         Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "billing_sales_order_lines_item_id_fkey")
  variant      ItemVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "billing_sales_order_lines_variant_id_fkey")
  price        Price?       @relation(fields: [priceId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "billing_sales_order_lines_price_id_fkey")
  sourceTaxRate TaxRate?    @relation(fields: [taxRateId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "billing_sales_order_lines_tax_rate_id_fkey")

  @@unique([salesOrderId, position], name: "billing_sales_order_lines_order_position_key", map: "billing_sales_order_lines_sales_order_id_position_key")
  @@index([salesOrderId], map: "billing_sales_order_lines_sales_order_id_idx")
  @@index([itemId], map: "billing_sales_order_lines_item_id_idx")
  @@index([variantId], map: "billing_sales_order_lines_variant_id_idx")
  @@index([priceId], map: "billing_sales_order_lines_price_id_idx")
  @@index([taxRateId], map: "billing_sales_order_lines_tax_rate_id_idx")
  @@map("billing_sales_order_lines")
}
