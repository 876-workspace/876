/// Immutable sellable, pricing, tax, and discount snapshot captured on a Sales
/// Receipt at the time the immediate paid sale is recorded.
model SalesReceiptLine {
  id             String   @id
  salesReceiptId String   @map("sales_receipt_id")
  itemId         String?  @map("item_id")
  variantId      String?  @map("variant_id")
  variantName    String?  @map("variant_name")
  variantSku     String?  @map("variant_sku")
  priceId        String?  @map("price_id")
  taxRateId      String?  @map("tax_rate_id")
  description    String
  unit           String?
  position       Int      @default(0)
  quantity       Int      @default(1)
  unitAmount     BigInt   @map("unit_amount")
  taxAmount      BigInt   @default(0) @map("tax_amount")
  taxName        String?  @map("tax_name")
  taxRate        Decimal? @map("tax_rate") @db.Decimal(7, 4)
  taxInclusive   Boolean  @default(false) @map("tax_inclusive")
  discountAmount BigInt   @default(0) @map("discount_amount")
  totalAmount    BigInt   @map("total_amount")
  createdAt      Int      @map("created_at")
  updatedAt      Int      @map("updated_at")

  salesReceipt SalesReceipt @relation(fields: [salesReceiptId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_sales_receipt_lines_sales_receipt_id_fkey")
  item         Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "billing_sales_receipt_lines_item_id_fkey")
  variant      ItemVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "billing_sales_receipt_lines_variant_id_fkey")
  price        Price?       @relation(fields: [priceId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "billing_sales_receipt_lines_price_id_fkey")
  sourceTaxRate TaxRate?    @relation(fields: [taxRateId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "billing_sales_receipt_lines_tax_rate_id_fkey")

  @@unique([salesReceiptId, position], name: "billing_sales_receipt_lines_receipt_position_key", map: "billing_sales_receipt_lines_sales_receipt_id_position_key")
  @@index([salesReceiptId], map: "billing_sales_receipt_lines_sales_receipt_id_idx")
  @@index([itemId], map: "billing_sales_receipt_lines_item_id_idx")
  @@index([variantId], map: "billing_sales_receipt_lines_variant_id_idx")
  @@index([priceId], map: "billing_sales_receipt_lines_price_id_idx")
  @@index([taxRateId], map: "billing_sales_receipt_lines_tax_rate_id_idx")
  @@map("billing_sales_receipt_lines")
}
