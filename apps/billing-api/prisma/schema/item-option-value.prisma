/// One customer-authored value within an Item option, such as Black or Medium.
model ItemOptionValue {
  id        String @id
  optionId  String @map("option_id")
  value     String
  position  Int    @default(0)
  createdAt Int    @map("created_at")
  updatedAt Int    @map("updated_at")

  option        ItemOption               @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_item_option_values_option_id_fkey")
  variantValues ItemVariantOptionValue[]

  @@unique([optionId, value], name: "billing_item_option_values_option_value_key", map: "billing_item_option_values_option_value_key")
  @@unique([optionId, position], name: "billing_item_option_values_option_position_key", map: "billing_item_option_values_option_position_key")
  @@index([optionId], map: "billing_item_option_values_option_id_idx")
  @@map("billing_item_option_values")
}
