/// An immediate paid sale. A Sales Receipt records the commercial sale and its
/// settled Payment together without creating Accounts Receivable.
model SalesReceipt {
  id                      String             @id
  tenantId                String             @map("tenant_id")
  sourceAppId             String?            @map("source_app_id")
  sourceExternalReference String?            @map("source_external_reference")
  sourceIdempotencyKey    String?            @map("source_idempotency_key")
  sourcePayloadHash       String?            @map("source_payload_hash")
  customerId              String             @map("customer_id")
  priceListId             String?            @map("price_list_id")
  priceListName           String?            @map("price_list_name")
  quoteId                 String?            @unique @map("quote_id")
  paymentId               String             @map("payment_id")
  salespersonId           String?            @map("salesperson_id")
  number                  String
  status                  SalesReceiptStatus @default(PAID)
  currency                String
  referenceNumber         String?            @map("reference_number")
  taxBehavior             TaxBehavior        @default(EXCLUSIVE) @map("tax_behavior")
  customerName            String?            @map("customer_name")
  customerEmail           String?            @map("customer_email")
  billingAddressSnapshot  Json?              @map("billing_address_snapshot")
  shippingAddressSnapshot Json?              @map("shipping_address_snapshot")
  receiptAt               Int                @map("receipt_at")
  sentAt                  Int?               @map("sent_at")
  voidedAt                Int?               @map("voided_at")
  voidReason              String?            @map("void_reason")
  subtotalAmount          BigInt             @default(0) @map("subtotal_amount")
  taxAmount               BigInt             @default(0) @map("tax_amount")
  discountAmount          BigInt             @default(0) @map("discount_amount")
  totalAmount             BigInt             @default(0) @map("total_amount")
  salespersonName         String?            @map("salesperson_name")
  notes                   String?
  terms                   String?
  metadata                Json?
  createdAt               Int                @map("created_at")
  updatedAt               Int                @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_sales_receipts_tenant_id_fkey")
  customer    Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "billing_sales_receipts_customer_fkey")
  priceList   PriceList?   @relation(fields: [tenantId, priceListId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "billing_sales_receipts_price_list_fkey")
  quote       Quote?       @relation("QuoteConvertedSalesReceipt", fields: [quoteId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "billing_sales_receipts_quote_id_fkey")
  payment     Payment      @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "billing_sales_receipts_payment_fkey")
  salesperson Salesperson? @relation(fields: [tenantId, salespersonId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "billing_sales_receipts_salesperson_fkey")
  lines       SalesReceiptLine[]
  creditNotes CreditNote[] @relation("SalesReceiptCreditNotes")

  @@unique([tenantId, id], map: "billing_sales_receipts_tenant_id_id_key")
  @@unique([tenantId, number], name: "billing_sales_receipts_tenant_id_number_key", map: "billing_sales_receipts_tenant_id_number_key")
  @@unique([tenantId, paymentId], name: "billing_sales_receipts_tenant_payment_key", map: "billing_sales_receipts_tenant_payment_id_key")
  @@unique([tenantId, sourceAppId, sourceExternalReference], name: "billing_sales_receipts_source_external_key", map: "billing_sales_receipts_source_external_key")
  @@unique([tenantId, sourceAppId, sourceIdempotencyKey], name: "billing_sales_receipts_source_idempotency_key", map: "billing_sales_receipts_source_idempotency_key")
  @@index([tenantId, status, receiptAt], map: "billing_sales_receipts_tenant_status_receipt_at_idx")
  @@index([tenantId, customerId, receiptAt], map: "billing_sales_receipts_tenant_customer_receipt_at_idx")
  @@index([tenantId, sourceAppId], map: "billing_sales_receipts_source_app_idx")
  @@index([priceListId], map: "billing_sales_receipts_price_list_id_idx")
  @@index([salespersonId], map: "billing_sales_receipts_salesperson_id_idx")
  @@map("billing_sales_receipts")
}
