/// Associates one generated Variant with exactly one value from each Item option.
model ItemVariantOptionValue {
  variantId     String @map("variant_id")
  optionId      String @map("option_id")
  optionValueId String @map("option_value_id")

  variant     ItemVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_item_variant_values_variant_id_fkey")
  option      ItemOption      @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_item_variant_values_option_id_fkey")
  optionValue ItemOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_item_variant_values_option_value_id_fkey")

  @@id([variantId, optionId], map: "billing_item_variant_values_pkey")
  @@unique([variantId, optionValueId], name: "billing_item_variant_values_variant_value_key", map: "billing_item_variant_values_variant_value_key")
  @@index([optionId, optionValueId], map: "billing_item_variant_values_option_value_idx")
  @@map("billing_item_variant_values")
}
