/// Ordered 876 Storage file references attached to an Item or one of its Variants.
/// `fileId` and `targetKey` are opaque cross-service identifiers; no Storage FK exists.
model ItemMedia {
  id        String  @id
  tenantId  String  @map("tenant_id")
  itemId    String  @map("item_id")
  variantId String? @map("variant_id")
  targetKey String  @map("target_key")
  fileId    String  @map("file_id")
  position  Int     @default(0)
  createdAt Int     @map("created_at")
  updatedAt Int     @map("updated_at")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_item_media_tenant_id_fkey")
  item    Item         @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_item_media_item_id_fkey")
  variant ItemVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_item_media_variant_id_fkey")

  @@unique([tenantId, targetKey, fileId], name: "billing_item_media_target_file_key", map: "billing_item_media_target_file_key")
  @@unique([tenantId, targetKey, position], name: "billing_item_media_target_position_key", map: "billing_item_media_target_position_key")
  @@index([tenantId, itemId], map: "billing_item_media_tenant_item_idx")
  @@index([tenantId, variantId], map: "billing_item_media_tenant_variant_idx")
  @@map("billing_item_media")
}
