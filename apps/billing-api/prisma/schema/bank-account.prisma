/// A tenant-owned financial account used to track canonical booked money
/// movement and reconcile it against external statement evidence.
/// One account has exactly one currency; cross-currency conversion is outside
/// this foundation.
///
/// `directoryBankId` / `directoryBranchId` are opaque Core directory IDs. They
/// intentionally have no Prisma relation because Core and Billing are separate
/// bounded contexts and databases.
model BankAccount {
  id                   String          @id
  tenantId             String          @map("tenant_id")
  name                 String          @db.VarChar(120)
  accountType          BankAccountType @map("account_type")
  currency             String          @db.Char(3)
  description          String?         @db.Text
  directoryBankId      String?         @map("directory_bank_id") @db.VarChar(255)
  directoryBranchId    String?         @map("directory_branch_id") @db.VarChar(255)
  institutionName      String?         @map("institution_name") @db.VarChar(160)
  accountHolderName    String?         @map("account_holder_name") @db.VarChar(160)
  accountNumberLast4   String?         @map("account_number_last4") @db.VarChar(4)
  /// Full account number, sealed through `@/platform/secure-field` and bound to
  /// this tenant and account. Never serialized; disclosed only by the dedicated
  /// account-number route. `accountNumberLast4` is derived from it for display.
  accountNumberCiphertext String?      @map("account_number_ciphertext") @db.Text
  accountNumberKeyId   String?         @map("account_number_key_id") @db.VarChar(255)
  accountNumberProvider String?        @map("account_number_provider") @db.VarChar(40)
  openingBalance       BigInt          @default(0) @map("opening_balance")
  openingBalanceAt     Int?            @map("opening_balance_at")
  bankBalance          BigInt?         @map("bank_balance")
  bankBalanceAt        Int?            @map("bank_balance_at")
  lastStatementBalance BigInt?         @map("last_statement_balance")
  lastStatementAt      Int?            @map("last_statement_at")
  isActive             Boolean         @default(true) @map("is_active")
  isSystem             Boolean         @default(false) @map("is_system")
  createdAt            Int             @map("created_at")
  updatedAt            Int             @map("updated_at")

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_bank_accounts_tenant_id_fkey")
  transactions     BankTransaction[]
  payments         Payment[]
  refunds          Refund[]
  statementImports BankStatementImport[]
  statementLines   BankStatementLine[]
  ruleAssignments  BankRuleAccount[]
  reconciliations  BankReconciliation[]
  transfersFrom    BankTransfer[]           @relation("BankTransferFromAccount")
  transfersTo      BankTransfer[]           @relation("BankTransferToAccount")
  depositsFrom     BankDeposit[]            @relation("BankDepositSourceAccount")
  depositsTo       BankDeposit[]            @relation("BankDepositDestinationAccount")

  @@unique([tenantId, id], map: "billing_bank_accounts_tenant_id_id_key")
  @@unique([tenantId, name], map: "billing_bank_accounts_tenant_id_name_key")
  @@index([tenantId, isActive], map: "billing_bank_accounts_tenant_id_is_active_idx")
  @@index([directoryBankId], map: "billing_bank_accounts_directory_bank_id_idx")
  @@index([directoryBranchId], map: "billing_bank_accounts_directory_branch_id_idx")
  @@map("billing_bank_accounts")
}
