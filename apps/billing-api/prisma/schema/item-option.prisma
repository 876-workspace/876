/// One option dimension on a variant Item, such as Color or Size.
model ItemOption {
  id        String @id
  tenantId  String @map("tenant_id")
  itemId    String @map("item_id")
  name      String
  position  Int    @default(0)
  createdAt Int    @map("created_at")
  updatedAt Int    @map("updated_at")

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_item_options_tenant_id_fkey")
  item          Item                     @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_item_options_item_id_fkey")
  values        ItemOptionValue[]
  variantValues ItemVariantOptionValue[]

  @@unique([itemId, name], name: "billing_item_options_item_name_key", map: "billing_item_options_item_name_key")
  @@unique([itemId, position], name: "billing_item_options_item_position_key", map: "billing_item_options_item_position_key")
  @@index([tenantId, itemId], map: "billing_item_options_tenant_item_idx")
  @@map("billing_item_options")
}
