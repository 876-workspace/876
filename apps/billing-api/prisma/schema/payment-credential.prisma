/// Pointer to the secret behind a payment method; no prohibited authentication
/// data is ever stored here, encrypted or otherwise.
model PaymentCredential {
  id              String                   @id
  tenantId        String                   @map("tenant_id")
  paymentMethodId String                   @map("payment_method_id")
  type            PaymentCredentialType
  storage         PaymentCredentialStorage
  sealedValue     String?                  @map("sealed_value") @db.Text
  keyId           String?                  @map("key_id")
  vaultProvider   String?                  @map("vault_provider")
  providerToken   String?                  @map("provider_token")
  provider        String?
  status          PaymentCredentialStatus  @default(ACTIVE)
  createdAt       Int                      @map("created_at")
  rotatedAt       Int?                     @map("rotated_at")
  revokedAt       Int?                     @map("revoked_at")
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_payment_credentials_tenant_fkey")
  paymentMethod   PaymentMethod            @relation(fields: [tenantId, paymentMethodId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade, map: "billing_payment_credentials_payment_method_fkey")

  @@unique([tenantId, paymentMethodId], map: "billing_payment_credentials_tenant_method_key")
  @@unique([tenantId, id], map: "billing_payment_credentials_tenant_id_id_key")
  @@index([tenantId, status], map: "billing_payment_credentials_tenant_status_idx")
  @@map("billing_payment_credentials")
}
