model BrandingPreference {
  tenantId    String @id @map("tenant_id")
  accentColor String @map("accent_color")
  appearance  String
  sidebarTone String @map("sidebar_tone")
  updatedBy   String? @map("updated_by")
  createdAt   Int    @map("created_at")
  updatedAt   Int    @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "billing_branding_preferences_tenant_id_fkey")

  @@map("billing_branding_preferences")
}
