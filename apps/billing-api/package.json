{
  "name": "@876/billing-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local src/server.ts",
    "generate": "node scripts/prisma-generate.mjs",
    "prebuild": "pnpm generate",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:baseline": "tsx scripts/baseline_migrations.ts",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:drift": "prisma migrate diff --from-schema prisma/schema --to-config-datasource --script",
    "db:migration:check": "prisma migrate status",
    "env:check": "tsx scripts/check_environment.ts",
    "cutover:check": "tsx scripts/check_cutover.ts",
    "db:reconcile": "tsx scripts/reconcile_databases.ts",
    "billing:run": "tsx src/workers/billing-sweep.cli.ts",
    "api:contract:check": "tsx scripts/generate_v1_contract_manifest.ts --check && tsx scripts/check_express_contract.ts",
    "api:contract:generate": "tsx scripts/generate_v1_openapi_snapshot.ts && tsx scripts/generate_v1_contract_manifest.ts",
    "api:contract:manifest:generate": "tsx scripts/generate_v1_contract_manifest.ts",
    "api:contract:manifest:check": "tsx scripts/generate_v1_contract_manifest.ts --check"
  },
  "dependencies": {
    "@876/communications": "workspace:*",
    "@876/core": "workspace:*",
    "@workos-inc/node": "10.10.0",
    "@876/server": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@prisma/extension-accelerate": "3.0.1",
    "@sentry/node": "10.70.0",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3",
    "zod-openapi": "6.0.1"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.2.0",
    "dotenv": "17.4.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
