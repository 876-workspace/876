PORT=4004
BILLING_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/billing
# Direct PostgreSQL URL used only by Prisma migration commands. It may equal
# BILLING_DATABASE_URL for a normal local PostgreSQL database.
BILLING_DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/billing
# Optional legacy source database used only by the reconciliation command.
BILLING_LEGACY_DATABASE_URL=
# Single-writer lease. Defaults to express; set none only to freeze mutations.
BILLING_WRITER=express
API_URL=http://127.0.0.1:4000
# Billing integration auth — must match the 876 Billing product app key in Console (876_app_secret_...).
# For local dev this is the same key stored as BILLING_API_876_KEY in apps/billing/.env.
BILLING_API_876_KEY=
# Internal service key for platform admin access. Must match API_INTERNAL_KEY in apps/api.
BILLING_INTERNAL_KEY=
BILLING_SCHEDULER_KEY=
# optional — only required when the Vercel cron is enabled
CRON_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3004
ENVIRONMENT=development
LOG_LEVEL=info
# Sentry error reporting; set this DSN with `wrangler secret put` at deploy time.
SENTRY_DSN=https://dba9d550a8121922a3021288456f4569@o4507681618591744.ingest.us.sentry.io/4511802778910720

# Workspace that receives platform-level customer.ensure events from Core.
# Efesto is the canonical platform/operator Billing tenant.
BILLING_PLATFORM_TENANT_SLUG=efesto

# Accounting-provider projection worker. Keep disabled until the migrations are
# applied and the provider credentials below are configured.
ACCOUNTING_PROVIDER_SYNC_ENABLED=false
ACCOUNTING_PROVIDER_SYNC_BATCH_SIZE=10

# Zoho Books OAuth client. The redirect URI must exactly match the callback
# registered in Zoho and should point to:
# /api/v1/providers/zoho-books/oauth/callback
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REDIRECT_URI=http://localhost:4004/api/v1/providers/zoho-books/oauth/callback
# Override for the Zoho data center when needed (for example .eu, .in, .com.au).
ZOHO_BOOKS_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# Sealing for bank account numbers and payment credentials. Deployed
# environments use WorkOS Vault; SECURE_FIELD_KEY (32-byte base64) is the local
# fallback. With neither set, saving an account number fails loudly.
WORKOS_API_KEY= # optional — required to seal through WorkOS Vault
WORKOS_VAULT_ENABLED= # optional — defaults to off
WORKOS_VAULT_KEY_CONTEXT= # optional — defaults to 876-billing
SECURE_FIELD_KEY= # optional — local development fallback only
