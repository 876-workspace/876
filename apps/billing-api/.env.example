PORT=4004
BILLING_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/billing
# Direct PostgreSQL URL used only by Prisma migration commands. It may equal
# BILLING_DATABASE_URL for a normal local PostgreSQL database.
BILLING_DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/billing
# Optional legacy source database used only by the reconciliation command.
BILLING_LEGACY_DATABASE_URL=
# Exactly one backend may own mutations: express, fastapi, legacy, or none.
BILLING_WRITER=express
API_URL=http://127.0.0.1:4000
# Billing integration auth — must match the 876 Billing product app key in Console (876_app_secret_...).
# For local dev this is the same key stored as BILLING_API_876_KEY in apps/billing/.env.
BILLING_API_876_KEY=
# Internal service key for platform admin access. Must match API_INTERNAL_KEY in apps/api.
BILLING_INTERNAL_KEY=
BILLING_SCHEDULER_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3004
ENVIRONMENT=development
LOG_LEVEL=info
# Sentry error reporting; set this DSN with `wrangler secret put` at deploy time.
SENTRY_DSN=https://dba9d550a8121922a3021288456f4569@o4507681618591744.ingest.us.sentry.io/4511802778910720

# Workspace that receives platform-level customer.ensure events from Core.
BILLING_PLATFORM_TENANT_SLUG=
