{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "876-billing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "876-billing",
    },
  ],
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }],
  // Non-secret service URLs. Secrets are set with `wrangler secret put`.
  "vars": {
    "API_URL": "https://876-api.raheemforschool.workers.dev",
    "WIDGETS_API_URL": "https://876-widgets-api.raheemforschool.workers.dev",
    "BILLING_OAUTH_ISSUER": "https://876-api.raheemforschool.workers.dev",
    "SENTRY_DSN": "https://6734c1997cea1aa887a776b9c3578614@o4507681618591744.ingest.us.sentry.io/4511802776748032",
    "NEXT_PUBLIC_SENTRY_DSN": "https://6734c1997cea1aa887a776b9c3578614@o4507681618591744.ingest.us.sentry.io/4511802776748032",
  },
  "observability": {
    "enabled": true,
  },
}
