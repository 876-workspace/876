{
  "name": "@876/invoice-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:sw && next dev --turbopack --port 3006",
    "build:sw": "node ../../scripts/build-serwist.mjs",
    "build": "pnpm build:next",
    "build:next": "pnpm build:sw && NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start --port ${PORT:-3006}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo .open-next .wrangler"
  },
  "dependencies": {
    "@876/analytics": "workspace:*",
    "@876/billing": "workspace:*",
    "@876/client": "workspace:*",
    "@876/core": "workspace:*",
    "@876/sdk": "workspace:*",
    "@876/ui": "workspace:*",
    "@sentry/nextjs": "10.56.0",
    "@tanstack/react-table": "^9.1.2",
    "iron-session": "8.0.4",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "serwist": "9.5.12",
    "sonner": "2.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
