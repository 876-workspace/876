# Copy to .prod-secrets (gitignored), fill in, deploy, then delete the file.
#
#   cd apps/invoice && npx wrangler deploy --secrets-file .prod-secrets
#
# API_INTERNAL_KEY and SESSION_COOKIE_SECRET must match the values the
# production 876-api Worker carries — a mismatched session secret fails
# silently, treating every signed-in request as signed-out.
API_INTERNAL_KEY=
INVOICE_API_876_KEY=
CRM_SUPPORT_SERVICE_KEY=
SESSION_COOKIE_SECRET=
