# Core identity/platform
API_URL=http://127.0.0.1:4000
# Server-only. The platform bootstrap endpoints (routing memberships, app
# subscriptions) are admin-tier and authenticate with this secret. Never
# expose it to the browser.
API_INTERNAL_KEY=
SESSION_COOKIE_SECRET=
SESSION_COOKIE_NAME=876-session
# Generated for 876-invoice app. Reused by bounded session-tier service clients.
INVOICE_API_876_KEY=

# Invoice product identity
NEXT_PUBLIC_876_APP_SLUG=876-invoice
NEXT_PUBLIC_INVOICE_URL=http://localhost:3006
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared financial service
BILLING_API_URL=http://127.0.0.1:4004

# Shared Work productivity service. Invoice uses its own app key above plus the
# signed-in user's bearer token; it must never receive WORK_INTERNAL_KEY.
WORK_API_URL=http://127.0.0.1:4020

# Server-only CRM origin and support-only first-party service key.
CRM_API_URL=http://127.0.0.1:4010
CRM_SUPPORT_SERVICE_KEY=

# Shared ecosystem
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_APP_ENVIRONMENT=development

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Widgets (optional, for future notes/collections if needed)
WIDGETS_API_URL=http://127.0.0.1:3005
