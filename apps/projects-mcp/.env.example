# Base URL of apps/projects-api.
# OPTIONAL — defaults to the production API (https://876-projects-api.vercel.app).
# Only set this to point the MCP server at a local apps/projects-api while
# developing a change; unset it again to go back to production.
# PROJECTS_API_URL=http://localhost:4030

# Operator credential for the 876 Projects API. Required.
PROJECTS_INTERNAL_KEY=

# The organization every tool call acts for. Required.
PROJECTS_ORGANIZATION_ID=

# Optional: Default user ID used as creatorUserId / comment author when omitted
PROJECTS_DEFAULT_USER_ID=
