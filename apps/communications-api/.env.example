COMMUNICATIONS_DATABASE_URL=
COMMUNICATIONS_DIRECT_DATABASE_URL=
COMMUNICATIONS_INTERNAL_KEY=
RESEND_API_KEY=

# The webhook endpoint rejects every request while the secret is unset, so an
# unsigned payload can never be accepted.
RESEND_WEBHOOK_SECRET=  # optional — the service starts without a provider webhook configured
PLATFORM_SENDING_DOMAIN=  # optional — defaults to mail.87six.dev, the one verified domain behind every `managed` sender

PORT=4050  # optional — defaults to 4050; 4040 belongs to @876/commerce-api
ENVIRONMENT=development  # optional — `development` turns on pretty log output
LOG_LEVEL=info  # optional — defaults to info
