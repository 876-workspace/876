{
  "name": "@876/communications-api",
  "version": "0.1.0",
  "description": "876 shared transactional communications service API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch -C react-server --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local src/server.ts",
    "prebuild": "node scripts/prisma-generate.mjs",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "node scripts/prisma-generate.mjs && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "pretest": "node scripts/prisma-generate.mjs",
    "test": "vitest run",
    "lint": "eslint src",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "generate": "node scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@876/communications": "workspace:*",
    "@876/core": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.2.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
