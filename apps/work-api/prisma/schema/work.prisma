enum WorkTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkReminderStatus {
  SCHEDULED
  SENT
  DISMISSED
  CANCELLED
}

model WorkTask {
  id              String         @id
  tenantId        String         @map("tenant_id")
  contextService  String?        @map("context_service")
  contextResource String?        @map("context_resource")
  contextId       String?        @map("context_id")
  title           String
  description     String?
  status          WorkTaskStatus @default(OPEN)
  /// Opaque source-domain priority reference. Work deliberately owns no CRM priority FK.
  priorityId      String?        @map("priority_id")
  assigneeId      String?        @map("assignee_id")
  dueAt           DateTime?      @map("due_at")
  completedAt     DateTime?      @map("completed_at")
  completedBy     String?        @map("completed_by")
  sortOrder       Int            @default(0) @map("sort_order")
  createdBy       String         @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")
  deletedBy       String?        @map("deleted_by")
  tenant          WorkTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, contextService, contextResource, contextId, status, sortOrder])
  @@index([tenantId, priorityId, status])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, dueAt])
  @@map("work_tasks")
}

model WorkReminder {
  id              String             @id
  tenantId        String             @map("tenant_id")
  contextService  String?            @map("context_service")
  contextResource String?            @map("context_resource")
  contextId       String?            @map("context_id")
  title           String
  note            String?
  remindAt        DateTime           @map("remind_at")
  userId          String             @map("user_id")
  status          WorkReminderStatus @default(SCHEDULED)
  sentAt          DateTime?          @map("sent_at")
  dismissedAt     DateTime?          @map("dismissed_at")
  createdBy       String             @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")
  deletedBy       String?            @map("deleted_by")
  tenant          WorkTenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, contextService, contextResource, contextId, remindAt])
  @@index([tenantId, userId, status, remindAt])
  @@map("work_reminders")
}
