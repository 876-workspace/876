enum WorkTaskStatus { OPEN IN_PROGRESS WAITING DEFERRED DONE CANCELLED FAILED }
enum WorkTaskImportance { LOW NORMAL HIGH URGENT }
enum WorkAssignmentTargetType { USER TEAM }
enum WorkAssignmentRole { OWNER COLLABORATOR REVIEWER WATCHER }
enum WorkAssignmentStatus { PENDING ACCEPTED DECLINED COMPLETED }
enum WorkReminderStatus { SCHEDULED SENT DISMISSED CANCELLED }
enum WorkRecurrenceFrequency { DAILY WEEKLY MONTHLY YEARLY }
enum WorkAlertTriggerType { ABSOLUTE RELATIVE }
enum WorkAlertAction { NOTIFICATION EMAIL }
enum WorkAlertStatus { SCHEDULED SENT DISMISSED CANCELLED }
enum WorkNotificationSourceType { ALERT REMINDER }
enum WorkNotificationStatus { PENDING DISPATCHED FAILED }

model WorkTaskList {
  id String @id
  tenantId String @map("tenant_id")
  name String
  description String?
  ownerUserId String? @map("owner_user_id")
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int @default(0) @map("sort_order")
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String? @map("deleted_by")
  tenant WorkTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  tasks WorkTask[]
  @@index([tenantId,ownerUserId,sortOrder])
  @@map("work_task_lists")
}

model WorkRecurrenceRule {
  id String @id
  tenantId String @map("tenant_id")
  frequency WorkRecurrenceFrequency
  interval Int @default(1)
  byDay String[] @default([]) @map("by_day")
  byMonthDay Int[] @default([]) @map("by_month_day")
  byMonth Int[] @default([]) @map("by_month")
  count Int?
  untilAt DateTime? @map("until_at")
  timeZone String @map("time_zone")
  weekStart String? @map("week_start")
  rrule String
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant WorkTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  tasks WorkTask[]
  reminders WorkReminder[]
  events WorkEvent[]
  @@index([tenantId,createdAt])
  @@map("work_recurrence_rules")
}

model WorkTask {
  id String @id
  uid String @unique
  tenantId String @map("tenant_id")
  listId String @map("list_id")
  parentTaskId String? @map("parent_task_id")
  contextService String? @map("context_service")
  contextResource String? @map("context_resource")
  contextId String? @map("context_id")
  title String
  description String?
  status WorkTaskStatus @default(OPEN)
  importance WorkTaskImportance @default(NORMAL)
  priorityId String? @map("priority_id")
  assigneeId String? @map("assignee_id")
  startAt DateTime? @map("start_at")
  startTimeZone String? @map("start_time_zone")
  dueAt DateTime? @map("due_at")
  dueTimeZone String? @map("due_time_zone")
  estimatedDuration String? @map("estimated_duration")
  percentComplete Int @default(0) @map("percent_complete")
  recurrenceRuleId String? @map("recurrence_rule_id")
  completedAt DateTime? @map("completed_at")
  completedBy String? @map("completed_by")
  sortOrder Int @default(0) @map("sort_order")
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String? @map("deleted_by")
  tenant WorkTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  list WorkTaskList @relation(fields:[listId],references:[id],onDelete:Restrict)
  parentTask WorkTask? @relation("WorkTaskHierarchy",fields:[parentTaskId],references:[id],onDelete:SetNull)
  subtasks WorkTask[] @relation("WorkTaskHierarchy")
  recurrenceRule WorkRecurrenceRule? @relation(fields:[recurrenceRuleId],references:[id],onDelete:SetNull)
  links WorkTaskLink[]
  assignments WorkTaskAssignment[]
  alerts WorkAlert[]
  @@index([tenantId,listId,status,sortOrder])
  @@index([tenantId,parentTaskId,status,sortOrder])
  @@index([tenantId,contextService,contextResource,contextId,status,sortOrder])
  @@index([tenantId,priorityId,status])
  @@index([tenantId,assigneeId,status])
  @@index([tenantId,startAt])
  @@index([tenantId,dueAt])
  @@map("work_tasks")
}

model WorkTaskLink {
  id String @id
  taskId String @map("task_id")
  service String
  resource String
  externalId String @map("external_id")
  label String?
  url String?
  isPrimary Boolean @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  task WorkTask @relation(fields:[taskId],references:[id],onDelete:Cascade)
  @@unique([taskId,service,resource,externalId])
  @@index([service,resource,externalId])
  @@map("work_task_links")
}

model WorkTaskAssignment {
  id String @id
  taskId String @map("task_id")
  targetType WorkAssignmentTargetType @map("target_type")
  assigneeId String @map("assignee_id")
  role WorkAssignmentRole @default(OWNER)
  status WorkAssignmentStatus @default(PENDING)
  assignedBy String @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")
  respondedAt DateTime? @map("responded_at")
  completedAt DateTime? @map("completed_at")
  delegatedFromAssignmentId String? @map("delegated_from_assignment_id")
  task WorkTask @relation(fields:[taskId],references:[id],onDelete:Cascade)
  delegatedFrom WorkTaskAssignment? @relation("WorkAssignmentDelegation",fields:[delegatedFromAssignmentId],references:[id],onDelete:SetNull)
  delegations WorkTaskAssignment[] @relation("WorkAssignmentDelegation")
  @@unique([taskId,targetType,assigneeId,role])
  @@index([assigneeId,status,assignedAt])
  @@map("work_task_assignments")
}

model WorkReminder {
  id String @id
  tenantId String @map("tenant_id")
  contextService String? @map("context_service")
  contextResource String? @map("context_resource")
  contextId String? @map("context_id")
  title String
  note String?
  remindAt DateTime @map("remind_at")
  timeZone String? @map("time_zone")
  recurrenceRuleId String? @map("recurrence_rule_id")
  userId String @map("user_id")
  status WorkReminderStatus @default(SCHEDULED)
  sentAt DateTime? @map("sent_at")
  dismissedAt DateTime? @map("dismissed_at")
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String? @map("deleted_by")
  tenant WorkTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  recurrenceRule WorkRecurrenceRule? @relation(fields:[recurrenceRuleId],references:[id],onDelete:SetNull)
  @@index([tenantId,contextService,contextResource,contextId,remindAt])
  @@index([tenantId,userId,status,remindAt])
  @@map("work_reminders")
}

model WorkAlert {
  id String @id
  tenantId String @map("tenant_id")
  taskId String? @map("task_id")
  eventId String? @map("event_id")
  userId String @map("user_id")
  triggerType WorkAlertTriggerType @map("trigger_type")
  triggerAt DateTime? @map("trigger_at")
  offsetSeconds Int? @map("offset_seconds")
  action WorkAlertAction @default(NOTIFICATION)
  status WorkAlertStatus @default(SCHEDULED)
  sentAt DateTime? @map("sent_at")
  dismissedAt DateTime? @map("dismissed_at")
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant WorkTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  task WorkTask? @relation(fields:[taskId],references:[id],onDelete:Cascade)
  event WorkEvent? @relation(fields:[eventId],references:[id],onDelete:Cascade)
  @@index([tenantId,userId,status,triggerAt])
  @@index([taskId])
  @@index([eventId])
  @@map("work_alerts")
}

model WorkNotificationOutbox {
  id String @id
  tenantId String @map("tenant_id")
  sourceType WorkNotificationSourceType @map("source_type")
  sourceId String @map("source_id")
  occurrenceKey String @map("occurrence_key")
  userId String @map("user_id")
  channel WorkAlertAction
  deliverAt DateTime @map("deliver_at")
  payload Json
  status WorkNotificationStatus @default(PENDING)
  attempts Int @default(0)
  dispatchedAt DateTime? @map("dispatched_at")
  lastError String? @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant WorkTenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  @@unique([sourceType,sourceId,occurrenceKey,channel])
  @@index([status,deliverAt])
  @@map("work_notification_outbox")
}
