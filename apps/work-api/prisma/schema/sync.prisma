enum WorkSyncProvider {
  ICALENDAR
  GOOGLE
  MICROSOFT
  CALDAV
}

enum WorkSyncConnectionStatus {
  ACTIVE
  PAUSED
  REVOKED
  ERROR
}

enum WorkSyncResourceType {
  TASK
  TASK_LIST
  CALENDAR
  EVENT
}

enum WorkSyncDirection {
  BIDIRECTIONAL
  PULL_ONLY
}

model WorkSyncConnection {
  id                   String                   @id
  tenantId             String                   @map("tenant_id")
  userId               String                   @map("user_id")
  provider             WorkSyncProvider
  status               WorkSyncConnectionStatus @default(ACTIVE)
  credentialRef        String?                  @map("credential_ref")
  remoteAccountId      String?                  @map("remote_account_id")
  remoteAccountLabel   String?                  @map("remote_account_label")
  caldavUrl            String?                  @map("caldav_url")
  syncCursor           String?                  @map("sync_cursor")
  lastSyncedAt         DateTime?                @map("last_synced_at")
  lastErrorCode        String?                  @map("last_error_code")
  oauthStateHash       String?                  @map("oauth_state_hash")
  oauthStateExpiresAt  DateTime?                @map("oauth_state_expires_at")
  syncLeaseToken       String?                  @map("sync_lease_token")
  syncLeaseExpiresAt   DateTime?                @map("sync_lease_expires_at")
  syncLeaseHeartbeatAt DateTime?                @map("sync_lease_heartbeat_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  tenant               WorkTenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credential           WorkSyncCredential?
  mappings             WorkSyncMapping[]

  @@index([tenantId, userId, provider, status])
  @@index([status, syncLeaseExpiresAt])
  @@map("work_sync_connections")
}

model WorkSyncCredential {
  id            String             @id
  connectionId  String             @unique @map("connection_id")
  sealedSecret  String             @map("sealed_secret")
  keyId         String?            @map("key_id")
  vaultProvider String             @map("vault_provider")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  connection    WorkSyncConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("work_sync_credentials")
}

model WorkSyncMapping {
  id              String               @id
  connectionId    String               @map("connection_id")
  parentMappingId String?              @map("parent_mapping_id")
  resourceType    WorkSyncResourceType @map("resource_type")
  syncDirection   WorkSyncDirection    @default(BIDIRECTIONAL) @map("sync_direction")
  localId         String               @map("local_id")
  remoteId        String               @map("remote_id")
  remoteEtag      String?              @map("remote_etag")
  iCalUid         String?              @map("ical_uid")
  contentHash     String?              @map("content_hash")
  syncCursor      String?              @map("sync_cursor")
  syncWindowStart DateTime?            @map("sync_window_start")
  syncWindowEnd   DateTime?            @map("sync_window_end")
  lastSyncedAt    DateTime?            @map("last_synced_at")
  lastErrorCode   String?              @map("last_error_code")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  connection      WorkSyncConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  parentMapping   WorkSyncMapping?      @relation("WorkSyncMappingChildren", fields: [parentMappingId], references: [id], onDelete: Cascade)
  childMappings   WorkSyncMapping[]     @relation("WorkSyncMappingChildren")

  @@index([connectionId, resourceType, localId])
  @@index([connectionId, resourceType, remoteId])
  @@index([parentMappingId, resourceType, localId])
  @@index([parentMappingId, resourceType, remoteId])
  @@index([iCalUid])
  @@map("work_sync_mappings")
}
