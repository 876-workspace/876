# The Work database. The pooled URL is used at runtime; the direct URL is used
# by `prisma migrate`, which cannot hold advisory locks through the pooler.
WORK_DATABASE_URL=postgresql://user:password@host:5432/work
WORK_DIRECT_DATABASE_URL=postgresql://user:password@host:5432/work

# The 876 identity service. Work calls it to validate an app API key and to
# resolve a signed-in user's app membership, entitlement, and permissions, so
# an unreachable value fails every authenticated request closed.
API_URL=http://127.0.0.1:4000

# Operator-tier secret, shared with Console. Server-only, never in a browser
# bundle. An unset value rejects every operator request rather than allowing one.
WORK_INTERNAL_KEY=replace-me

# Scheduler-tier bearer token for the notification worker. Unset disables the
# scheduler tier, which then rejects every request to it.
WORK_CRON_SECRET=  # optional — unset closes the scheduler tier

# Sensitive provider credentials are sealed before they enter Work's database.
# WorkOS Vault is preferred in deployed environments. SECURE_FIELD_KEY is the
# development/test alternative and must decode from base64 to exactly 32 bytes.
WORKOS_VAULT_ENABLED=false  # optional — defaults to disabled
WORKOS_API_KEY=  # optional — required only when WorkOS Vault is enabled
WORKOS_VAULT_KEY_CONTEXT=876/work-sync  # optional — defaults to 876/work-sync
SECURE_FIELD_KEY=  # optional — alternative to WorkOS Vault for development/tests

# OAuth configuration for external calendar providers is introduced in Phase 6.
# Provider-specific client credentials remain server-only and are never exposed
# through Work resource serializers or browser routes.
WORK_GOOGLE_CLIENT_ID=  # optional — required only when Google sync is enabled
WORK_GOOGLE_CLIENT_SECRET=  # optional — required only when Google sync is enabled
WORK_GOOGLE_REDIRECT_URI=  # optional — required only when Google sync is enabled
WORK_MICROSOFT_CLIENT_ID=  # optional — required only when Microsoft sync is enabled
WORK_MICROSOFT_CLIENT_SECRET=  # optional — required only when Microsoft sync is enabled
WORK_MICROSOFT_REDIRECT_URI=  # optional — required only when Microsoft sync is enabled
WORK_MICROSOFT_TENANT=common  # optional — defaults to common
# Optional comma-separated exact HTTPS origins permitted for CalDAV. When set,
# every configured/discovered CalDAV URL must remain on one of these origins in
# addition to passing the public-IP outbound network policy.
WORK_CALDAV_ALLOWED_ORIGINS=  # optional — e.g. https://dav.example.com,https://calendar.example.com:8443

# Where the notification worker dispatches materialized occurrences.
WORK_NOTIFICATION_DISPATCH_URL=  # optional — unset disables dispatch
WORK_NOTIFICATION_DISPATCH_KEY=  # optional — unset disables dispatch

DELETION_MODE=soft  # optional — unset is soft-delete production behavior
PORT=4020  # optional — defaults to 4020
LOG_LEVEL=info  # optional — defaults to info
ENVIRONMENT=development  # optional — `development` turns on pretty log output
