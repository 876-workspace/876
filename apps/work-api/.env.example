# The Work database. The pooled URL is used at runtime; the direct URL is used
# by `prisma migrate`, which cannot hold advisory locks through the pooler.
WORK_DATABASE_URL=postgresql://user:password@host:5432/work
WORK_DIRECT_DATABASE_URL=postgresql://user:password@host:5432/work

# The 876 identity service. Work calls it to validate an app API key and to
# resolve a signed-in user's app membership, entitlement, and permissions, so
# an unreachable value fails every authenticated request closed.
API_URL=http://127.0.0.1:4000

# Operator-tier secret, shared with Console. Server-only, never in a browser
# bundle. An unset value rejects every operator request rather than allowing one.
WORK_INTERNAL_KEY=replace-me

# Scheduler-tier bearer token for the notification worker. Unset disables the
# scheduler tier, which then rejects every request to it.
WORK_CRON_SECRET=  # optional — unset closes the scheduler tier

# Where the notification worker dispatches materialized occurrences.
WORK_NOTIFICATION_DISPATCH_URL=  # optional — unset disables dispatch
WORK_NOTIFICATION_DISPATCH_KEY=  # optional — unset disables dispatch

DELETION_MODE=soft  # optional — unset is soft-delete production behavior
PORT=4020  # optional — defaults to 4020
LOG_LEVEL=info  # optional — defaults to info
ENVIRONMENT=development  # optional — `development` turns on pretty log output
