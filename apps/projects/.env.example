API_URL=
PROJECTS_API_URL=

# Operator credential for the 876 Projects service. Server-only.
PROJECTS_INTERNAL_KEY=

# The 876 platform app key (876_app_secret_...) this app's /api/auth bridge
# presents as X-876-API-Key. Issue it for the 876-projects app — never borrow
# another app's key (.claude/rules/env-configuration.md).
PROJECTS_API_876_KEY=

STORAGE_API_URL=
# Must equal apps/storage-api's value byte for byte. Required for the
# resource-links/attachments feature (project media, file references).
STORAGE_INTERNAL_KEY=

NEXT_PUBLIC_PROJECTS_URL=
# The consumer app origin, for the "go to my 876 account" escape link. An unset
# value ships a localhost fallback to production.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=

# Browser-facing origins for the app switcher (@876/core/apps-directory). An app
# whose URL is unset is omitted from the switcher; there is no fallback origin.
NEXT_PUBLIC_BILLING_URL=http://localhost:3004  # optional — the app is omitted from the app switcher when unset
NEXT_PUBLIC_COURIERS_URL=http://localhost:3003  # optional — the app is omitted from the app switcher when unset
NEXT_PUBLIC_CRM_URL=http://localhost:3007  # optional — the app is omitted from the app switcher when unset
NEXT_PUBLIC_INVOICE_URL=http://localhost:3006  # optional — the app is omitted from the app switcher when unset
NEXT_PUBLIC_ENTERPRISE_URL=http://localhost:3001  # optional — the app is omitted from the app switcher when unset
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3002  # optional — the app is omitted from the app switcher when unset
NEXT_PUBLIC_COMMERCE_URL=http://localhost:3009  # optional — the app is omitted from the app switcher when unset

API_INTERNAL_KEY=

# Must equal apps/api's value byte for byte. A mismatch makes every visitor look
# signed out and bounces them to /login forever, silently.
SESSION_COOKIE_SECRET=

SESSION_COOKIE_NAME=  # optional — defaults to the shared 876 session cookie name
