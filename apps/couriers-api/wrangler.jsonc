{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "876-couriers-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      // Cloudflare rejects a Container application name that starts with a
      // digit, so this cannot default to the Worker name (`876-couriers-api`).
      "name": "couriers-api-876",
      "class_name": "CouriersApiContainer",
      "image": "./Dockerfile",
      // The build context is the repository root because pnpm keeps a single
      // lockfile there; a context of apps/couriers-api has none.
      "image_build_context": "../../",
      // Raise after traffic validation; Containers are billed per instance-time.
      "max_instances": 5,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COURIERS_API_CONTAINER",
        "class_name": "CouriersApiContainer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CouriersApiContainer"],
    },
  ],
  // Non-secret defaults. Secrets: wrangler secret put <NAME> --name 876-couriers-api
  "vars": {
    "ENVIRONMENT": "production",
    "LOG_LEVEL": "info",
    "PORT": "4001",
  },
  "observability": {
    "enabled": true,
  },
}
