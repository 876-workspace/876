# Runtime configuration
PORT=4001
ENVIRONMENT=development
LOG_LEVEL=info

# Prisma Accelerate runtime URL. `pnpm db:generate` is offline and requires
# only this variable; it does not need a database connection.
DATABASE_URL=
# Direct PostgreSQL URL, required only by `prisma migrate`, `prisma db`, and
# Prisma Studio. Never expose either database URL to clients.
DIRECT_DATABASE_URL=

# Platform credentials. Keep the internal key server-side.
API_876_KEY=
API_INTERNAL_KEY=

# Platform OAuth access-token verification. The identity API signs tokens with
# RS256 and serves this issuer's JWKS at /oauth/.well-known/jwks.json. Set the
# audience to this service's registered OAuth client ID, not an API key.
OAUTH_ISSUER=
OAUTH_AUDIENCE=
# Optional explicit override for non-standard identity deployments.
OAUTH_JWKS_URL=

SENTRY_DSN=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003
