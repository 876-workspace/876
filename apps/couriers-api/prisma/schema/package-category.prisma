model PackageCategory {
  id              String   @id @default(cuid())
  tenantId        String?  @map("tenant_id")
  provisioningKey String?  @map("provisioning_key")
  name            String
  slug            String
  description     String?
  icon            String?
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       Int      @map("created_at")
  updatedAt       Int      @map("updated_at")
  deletedAt       Int?     @map("deleted_at")

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packages Package[]

  @@unique([tenantId, slug], map: "package_categories_tenant_id_slug_key", where: raw("(deleted_at IS NULL)"))
  @@unique([tenantId, provisioningKey], map: "package_categories_tenant_id_provisioning_key_key", where: raw("(deleted_at IS NULL AND provisioning_key IS NOT NULL)"))
  @@index([tenantId, isActive, sortOrder], map: "package_categories_tenant_id_is_active_sort_order_idx")
  @@map("package_categories")
}
