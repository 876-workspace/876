model Tenant {
  id            String       @id @default(cuid())
  orgId         String       @unique @map("org_id")
  slug          String       @unique
  name          String
  mailboxPrefix String?      @map("mailbox_prefix")
  status        TenantStatus @default(ACTIVE)
  createdAt     Int          @map("created_at")
  updatedAt     Int          @map("updated_at")

  @@map("tenants")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
