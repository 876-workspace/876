model Tenant {
  id            String       @id @default(cuid())
  orgId         String       @unique @map("org_id")
  slug          String       @unique
  name          String
  mailboxPrefix String?      @map("mailbox_prefix")
  status        TenantStatus @default(ACTIVE)
  createdAt     Int          @map("created_at")
  updatedAt     Int          @map("updated_at")

  addresses Address[]
  branches  Branch[]
  warehouses Warehouse[]
  customers  CourierCustomerProfile[]
  mailboxes  Mailbox[]
  packages   Package[]
  roles      Role[]
  teamMembers TeamMember[]
  organizationModules OrganizationModule[]
  modulePreferences ModulePreference[]

  @@map("tenants")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
