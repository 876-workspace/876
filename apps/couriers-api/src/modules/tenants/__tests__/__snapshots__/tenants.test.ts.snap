    "securitySchemes": {
      "ApiKey": {
        "description": "App API key (\`876_app_secret_…\`).",
        "in": "header",
        "name": "X-876-API-Key",
        "type": "apiKey",
      },
      "BearerToken": {
        "bearerFormat": "JWT",
        "description": "OAuth access token.",
        "scheme": "bearer",
        "type": "http",
      },
      "IntegrationKey": {
        "description": "Server-to-server Couriers integration key.",
        "in": "header",
        "name": "x-couriers-integration-key",
        "type": "apiKey",
      },
      "InternalKey": {
        "description": "Secret service key. Server-to-server only.",
        "in": "header",
        "name": "x-internal-key",
        "type": "apiKey",
      },
    },
