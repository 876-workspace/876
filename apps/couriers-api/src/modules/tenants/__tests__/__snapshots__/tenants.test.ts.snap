    "/v1/me/addresses": {
      "get": {
        "operationId": "me-addresses-list",
        "parameters": [
          {
            "in": "query",
            "name": "is_active",
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "country_code",
            "schema": {
              "maxLength": 2,
              "minLength": 2,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "starting_after",
            "schema": {
              "minLength": 1,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "ending_before",
            "schema": {
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "additionalProperties": false,
                      "properties": {
                        "data": {
                          "items": {
                            "$ref": "#/components/schemas/Address",
                          },
                          "type": "array",
                        },
                        "has_more": {
                          "type": "boolean",
                        },
                        "object": {
                          "const": "list",
                          "description": "Always 'list'.",
                          "type": "string",
                        },
                        "total_count": {
                          "anyOf": [
                            {
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "url": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "object",
                        "data",
                        "has_more",
                        "url",
                        "total_count",
                      ],
                      "type": "object",
                    },
                    "error": {
                      "type": "null",
                    },
                  },
                  "required": [
                    "data",
                    "error",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Addresses returned.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope",
                },
              },
            },
            "description": "Missing or invalid credentials.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope",
                },
              },
            },
            "description": "The caller is authenticated but not permitted.",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope",
                },
              },
            },
            "description": "The request failed validation.",
          },
        },
        "security": [
          {
            "ApiKey": [],
            "BearerToken": [],
          },
        ],
        "summary": "List the caller’s own addresses",
        "tags": [
          "Me",
        ],
      },
      "post": {
        "operationId": "me-addresses-create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "city": {
                    "maxLength": 120,
                    "minLength": 1,
                    "type": "string",
                  },
                  "country_code": {
                    "maxLength": 2,
                    "minLength": 2,
                    "type": "string",
                  },
                  "is_active": {
                    "type": "boolean",
                  },
                  "latitude": {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number",
                  },
                  "line1": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string",
                  },
                  "line2": {
                    "maxLength": 200,
                    "type": "string",
                  },
                  "longitude": {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number",
                  },
                  "name": {
                    "maxLength": 120,
                    "minLength": 1,
                    "type": "string",
                  },
                  "postal_code": {
                    "maxLength": 32,
                    "type": "string",
                  },
                  "region_code": {
                    "maxLength": 32,
                    "type": "string",
                  },
                },
                "required": [
                  "name",
                  "line1",
                  "city",
                  "country_code",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Address",
                    },
                    "error": {
                      "type": "null",
                    },
                  },
                  "required": [
                    "data",
                    "error",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Address created.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope",
                },
              },
            },
            "description": "Missing or invalid credentials.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope",
                },
              },
            },
            "description": "The caller is authenticated but not permitted.",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope",
                },
              },
            },
            "description": "The request failed validation.",
          },
        },
        "security": [
          {
            "ApiKey": [],
            "BearerToken": [],
          },
        ],
        "summary": "Create an address in the caller’s own tenant",
        "tags": [
          "Me",
        ],
      },
    },
