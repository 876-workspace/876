API_URL=http://localhost:4000
CRM_API_URL=http://localhost:4010
WORK_API_URL=http://localhost:4020
CRM_INTERNAL_KEY=
# Support-only first-party key bound to the 876-crm caller in
# CRM_SUPPORT_SERVICE_KEYS on crm-api. Never use CRM_INTERNAL_KEY for support.
CRM_SUPPORT_SERVICE_KEY=
# The 876 platform app key (876_app_secret_...) this app's /api/auth bridge
# presents as X-876-API-Key. The same scoped key is used with the signed user
# session when CRM calls Work; CRM never receives WORK_INTERNAL_KEY.
CRM_API_876_KEY=  # the 876-crm app's own key — never another app's; see .claude/rules/env-configuration.md
NEXT_PUBLIC_CRM_URL=http://localhost:3007
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_KEY=
SESSION_COOKIE_SECRET=
SESSION_COOKIE_NAME=876-session  # optional — defaults to 876-session
