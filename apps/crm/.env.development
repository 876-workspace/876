# Local-machine development URLs (non-secret). Server-to-server calls stay on
# loopback; the browser-visible NEXT_PUBLIC_* origins are rewritten per
# workspace by scripts/setup-dev-env.mjs into .env.development.local.
API_URL=http://127.0.0.1:4000
CRM_API_URL=http://127.0.0.1:4010

NEXT_PUBLIC_CRM_URL=http://localhost:3007
NEXT_PUBLIC_APP_URL=http://localhost:3000
