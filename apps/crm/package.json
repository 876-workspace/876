{
  "name": "@876/crm-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && next dev --turbopack --port 3007",
    "build": "prisma generate && NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start --port ${PORT:-3007}",
    "lint": "eslint",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@876/billing": "workspace:*",
    "@876/client": "workspace:*",
    "@876/core": "workspace:*",
    "@876/ui": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/nextjs": "10.56.0",
    "next": "16.3.1",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
