{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "876-widgets-api",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "876-widgets-api",
    },
  ],
  "vars": {
    "SENTRY_DSN": "https://b4507723864a778a1097eeeb587816ae@o4507681618591744.ingest.us.sentry.io/4511802776944640",
    "NEXT_PUBLIC_SENTRY_DSN": "https://b4507723864a778a1097eeeb587816ae@o4507681618591744.ingest.us.sentry.io/4511802776944640",
  },
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }],
  "observability": {
    "enabled": true,
  },
}
