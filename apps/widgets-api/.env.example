# Copy these values to apps/widgets-api/.env. Never commit real credentials.
# Widgets Postgres (Prisma Postgres) is only available to widgets-api.
WIDGETS_DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Generate one long random secret and copy it to each widget host's .env.
WIDGETS_SERVICE_KEY="replace-with-long-random-secret"

# Sentry error reporting (server runtime and browser build, respectively).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
