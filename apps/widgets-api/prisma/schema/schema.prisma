// Widgets bounded-context database (Prisma 7).
// Only apps/widgets-api may connect. Hosts never receive this URL.

// runtime = "nodejs" loads the query compiler from a base64 `.mjs` module, so
// Vercel's output tracer follows a plain import and ships the compiler inside
// the function. The "workerd" runtime instead imports
// `./query_compiler_fast_bg.wasm?module`, whose emitted `.wasm` the tracer
// cannot follow — it is left out of the lambda and every query throws
// `ENOENT … .wasm` at runtime.
generator client {
  provider = "prisma-client"
  output   = "../../src/lib/db/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}
