{
  "name": "@876/widgets-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma migrate deploy && prisma generate && next dev --turbopack --port 3005",
    "build": "pnpm build:next",
    "build:next": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=4096\" NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start -H :: --port ${PORT:-3005}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo .open-next .wrangler",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@876/core": "workspace:*",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "7.9.1",
    "@prisma/client": "7.9.1",
    "@prisma/extension-accelerate": "3.0.1",
    "@sentry/nextjs": "10.56.0",
    "next": "16.3.1",
    "pg": "8.23.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "prisma": "7.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
