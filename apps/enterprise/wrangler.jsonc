{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "876-enterprise",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "876-enterprise",
    },
  ],
  // Non-secret service URLs. Secrets are set with `wrangler secret put`.
  "vars": {
    "API_URL": "https://876-api.raheemforschool.workers.dev",
    "SENTRY_DSN": "https://3ee6b0b5285a3eb3a8808baab081b620@o4507681618591744.ingest.us.sentry.io/4511802776420352",
    "NEXT_PUBLIC_SENTRY_DSN": "https://3ee6b0b5285a3eb3a8808baab081b620@o4507681618591744.ingest.us.sentry.io/4511802776420352",
  },
  "observability": {
    "enabled": true,
  },
}
