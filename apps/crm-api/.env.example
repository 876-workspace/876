PORT=4010  # optional — defaults to 4010; the host sets it in production
CRM_DATABASE_URL=
CRM_DIRECT_DATABASE_URL=  # the unpooled Neon endpoint — prisma migrate/db/studio only
CRM_INTERNAL_KEY=
# JSON map of first-party service app slug -> service key. Issue a key for
# 876-couriers (alongside 876-crm, 876-console, 876-invoice, 876-billing).
CRM_SERVICE_KEYS=
# Core organization ID whose CRM workspace receives platform support requests.
CRM_SUPPORT_ORGANIZATION_ID=
# JSON map of first-party host app slug -> support-only service key.
# Example: {"876-crm":"...","876-billing":"...","876-invoice":"..."}
CRM_SUPPORT_SERVICE_KEYS=
BILLING_API_URL=http://localhost:4004
BILLING_INTERNAL_KEY=
CRM_API_876_KEY=  # the 876-crm app's own key — never another app's; see .claude/rules/env-configuration.md
WORK_API_URL=http://localhost:4020
DELETION_MODE=hard  # optional — unset means soft delete, which is the production behaviour
LOG_LEVEL=info  # optional — defaults to info
ENVIRONMENT=development  # optional — `development` turns on pretty log output
