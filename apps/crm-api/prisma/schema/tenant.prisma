enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id                   String       @id
  organizationId       String       @unique @map("organization_id")
  status               TenantStatus @default(ACTIVE)
  nextRequestNumber    Int          @default(1) @map("next_request_number")
  provisioningRevision Int          @default(0) @map("provisioning_revision")
  provisionedAt        DateTime?    @map("provisioned_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  customers              CustomerProfile[]
  requests               Request[]
  requestNotes           RequestNote[]
  requestPriorities      RequestPriorityDef[]
  teams                  Team[]
  teamMembers            TeamMember[]
  requestCategories      RequestCategoryDef[]
  requestSubcategories   RequestSubcategory[]
  requestForms           RequestForm[]
  requestFormSubmissions RequestFormSubmission[]

  @@map("crm_tenants")
}
