enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id             String       @id
  organizationId String       @unique @map("organization_id")
  status         TenantStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  customers CustomerProfile[]

  @@map("crm_tenants")
}
