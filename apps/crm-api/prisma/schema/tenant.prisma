enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id                String       @id
  organizationId    String       @unique @map("organization_id")
  status            TenantStatus @default(ACTIVE)
  nextRequestNumber Int          @default(1) @map("next_request_number")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  customers    CustomerProfile[]
  requests     Request[]
  requestNotes RequestNote[]
  teams Team[]
  teamMembers TeamMember[]
  requestCategories RequestCategoryDef[]
  requestSubcategories RequestSubcategory[]
  requestTasks RequestTask[]
  requestReminders RequestReminder[]

  @@map("crm_tenants")
}
