enum CustomerProfileStatus {
  ACTIVE
  INACTIVE
}

model CustomerProfile {
  id                String                @id
  tenantId          String                @map("tenant_id")
  billingCustomerId String                @map("billing_customer_id")
  ownerId           String?               @map("owner_id")
  status            CustomerProfileStatus @default(ACTIVE)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  deletedAt         DateTime?             @map("deleted_at")
  deletedBy         String?               @map("deleted_by")
  deletionReason    String?               @map("deletion_reason")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests Request[]

  @@unique([tenantId, billingCustomerId])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([ownerId])
  @@map("crm_customer_profiles")
}
