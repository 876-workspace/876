// MinistryDepartment — table `ministry_departments`.
// Module: directory. Directory reference data: institutions, branches, schools, and agencies.

model MinistryDepartment {
  id               String           @id @db.VarChar
  ministryId       String           @map("ministry_id") @db.VarChar
  name             String           @db.VarChar
  description      String?
  addressId        String           @map("address_id") @db.VarChar
  contactEmail     String?          @map("contact_email") @db.VarChar
  contactNumber    String?          @map("contact_number") @db.VarChar
  deletedAt        BigInt?          @map("deleted_at")
  deletedBy        String?          @map("deleted_by") @db.VarChar
  deletionReason   String?          @map("deletion_reason")
  createdAt        BigInt           @map("created_at")
  updatedAt        BigInt           @map("updated_at")
  directoryAddress DirectoryAddress @relation(fields: [addressId], references: [id], onUpdate: NoAction)
  ministry         Ministry         @relation(fields: [ministryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([addressId], map: "ix_ministry_departments_address_id")
  @@index([ministryId], map: "ix_ministry_departments_ministry_id")
  @@map("ministry_departments")
}
