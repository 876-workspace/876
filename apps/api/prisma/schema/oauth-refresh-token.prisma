// OauthRefreshToken — table `oauth_refresh_tokens`.
// Module: auth. Sessions, auth providers, OAuth grants/codes/tokens, SSO, OTP, and login attempts.

model OauthRefreshToken {
  id        String   @id @db.VarChar
  tokenHash String   @unique @map("token_hash") @db.VarChar
  userId    String   @map("user_id") @db.VarChar
  appId     String   @map("app_id") @db.VarChar
  sessionId String?  @map("session_id") @db.VarChar
  scope     String   @db.VarChar
  expiresAt BigInt   @map("expires_at")
  usedAt    BigInt?  @map("used_at")
  revokedAt BigInt?  @map("revoked_at")
  createdAt BigInt   @map("created_at")
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session   Session? @relation(fields: [sessionId], references: [id], onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("oauth_refresh_tokens")
}
