// UserSocialProfile — table `user_social_profiles`.
// Module: contacts. Addresses, contacts, and social profiles owned by users and organizations.

model UserSocialProfile {
  id             String         @id @db.VarChar
  userId         String         @map("user_id") @db.VarChar
  platformId     String         @map("platform_id") @db.VarChar
  handle         String         @db.VarChar
  profileUrl     String?        @map("profile_url") @db.VarChar
  displayName    String?        @map("display_name") @db.VarChar
  visibility     String         @default("private") @db.VarChar
  verifiedAt     BigInt?        @map("verified_at")
  metadata       Json?          @db.Json
  deletedAt      BigInt?        @map("deleted_at")
  deletedBy      String?        @map("deleted_by") @db.VarChar
  deletionReason String?        @map("deletion_reason")
  createdAt      BigInt         @map("created_at")
  updatedAt      BigInt         @map("updated_at")
  socialPlatform SocialPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, platformId, handle])
  @@map("user_social_profiles")
}
