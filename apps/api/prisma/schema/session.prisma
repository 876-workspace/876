// Session — table `sessions`.
// Module: auth. Sessions, auth providers, OAuth grants/codes/tokens, SSO, OTP, and login attempts.

model Session {
  id                 String              @id @db.VarChar
  userId             String              @map("user_id") @db.VarChar
  appId              String?             @map("app_id") @db.VarChar
  token              String?             @unique @db.VarChar
  tokenHash          String              @unique @map("token_hash") @db.VarChar
  expiresAt          BigInt              @map("expires_at")
  ipAddress          String?             @map("ip_address") @db.VarChar
  userAgent          String?             @map("user_agent") @db.VarChar
  createdAt          BigInt              @map("created_at")
  updatedAt          BigInt              @map("updated_at")
  deviceId           String?             @map("device_id") @db.VarChar
  ipCountryCode      String?             @map("ip_country_code") @db.VarChar(2)
  ipRegion           String?             @map("ip_region") @db.VarChar
  ipCity             String?             @map("ip_city") @db.VarChar
  ipAsn              String?             @map("ip_asn") @db.VarChar
  ipAsOrganization   String?             @map("ip_as_organization") @db.VarChar
  lastSeenAt         BigInt?             @map("last_seen_at")
  revokedAt          BigInt?             @map("revoked_at")
  revokedBy          String?             @map("revoked_by") @db.VarChar
  oauthRefreshTokens OauthRefreshToken[]
  app                App?                @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "ix_sessions_user_id")
  @@map("sessions")
}
