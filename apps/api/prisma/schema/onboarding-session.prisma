// OnboardingSession — table `onboarding_sessions`.
// Module: onboarding. Onboarding sessions and steps.

model OnboardingSession {
  id                String             @id @db.VarChar
  organizationId    String             @map("organization_id") @db.VarChar
  targetType        String             @map("target_type") @db.VarChar
  targetKey         String             @map("target_key") @db.VarChar
  countryCode       String             @map("country_code") @db.VarChar(2)
  schemaVersion     Int                @default(1) @map("schema_version")
  catalogRevision   Int                @map("catalog_revision")
  status            String             @default("draft") @db.VarChar
  submittedAt       BigInt?            @map("submitted_at")
  completedAt       BigInt?            @map("completed_at")
  createdAt         BigInt             @map("created_at")
  updatedAt         BigInt             @map("updated_at")
  onboardingAnswers OnboardingAnswer[]
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, targetType, targetKey, countryCode, schemaVersion, catalogRevision])
  @@index([organizationId], map: "ix_onboarding_sessions_organization_id")
  @@map("onboarding_sessions")
}
