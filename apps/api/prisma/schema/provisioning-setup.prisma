// ProvisioningSetup — table `provisioning_setups`.
// Module: provisioning. A named day-zero configuration. Its finance manifest is
// `finance/<key>`; exactly one setup is the platform fallback.
//
// Geographic applicability and access entitlements are normalized into the
// policy tables rather than encoded on this row. `countryCode`/`currencyCode`
// remain temporarily for development backfill compatibility and are no longer
// the source of truth for routing or finance defaults.

model ProvisioningSetup {
  id           String  @id @db.VarChar
  key          String  @unique(map: "uq_provisioning_setups_key") @db.VarChar
  name         String  @db.VarChar
  description  String?
  countryCode  String? @map("country_code") @db.VarChar(2)
  currencyCode String? @map("currency_code") @db.VarChar(3)
  status       String  @default("active") @db.VarChar
  isDefault    Boolean @default(false) @unique(map: "uq_provisioning_setups_default", where: raw("(is_default = true)")) @map("is_default")
  createdAt    BigInt  @map("created_at")
  updatedAt    BigInt  @map("updated_at")

  conditions   ProvisioningSetupCondition[]
  entitlements ProvisioningSetupEntitlement[]

  @@index([status], map: "ix_provisioning_setups_status")
  @@map("provisioning_setups")
}
