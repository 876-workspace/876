// Contact — table `contacts`.
// Module: contacts. Addresses, contacts, and social profiles owned by users and organizations.

model Contact {
  id             String  @id @db.VarChar
  ownerUserId    String  @map("owner_user_id") @db.VarChar
  contactUserId  String  @map("contact_user_id") @db.VarChar
  nickname       String? @db.VarChar
  notes          String?
  deletedAt      BigInt? @map("deleted_at")
  deletedBy      String? @map("deleted_by") @db.VarChar
  deletionReason String? @map("deletion_reason")
  createdAt      BigInt  @map("created_at")
  updatedAt      BigInt  @map("updated_at")
  contactUser    User    @relation("contacts_contact_user_idTousers", fields: [contactUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ownerUser      User    @relation("contacts_owner_user_idTousers", fields: [ownerUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([ownerUserId, contactUserId])
  @@map("contacts")
}
