// InviteToken — table `invite_tokens`.
// Module: auth. Sessions, auth providers, OAuth grants/codes/tokens, SSO, OTP, and login attempts.

model InviteToken {
  id             String       @id @db.VarChar
  organizationId String       @map("organization_id") @db.VarChar
  email          String       @db.VarChar
  role           String       @default("member") @db.VarChar
  token          String       @unique @db.VarChar
  status         String       @default("pending") @db.VarChar
  expiresAt      BigInt       @map("expires_at")
  sourceAppId    String?      @map("source_app_id") @db.VarChar
  createdAt      BigInt       @map("created_at")
  updatedAt      BigInt       @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app            App?         @relation(fields: [sourceAppId], references: [id], onUpdate: NoAction)

  @@map("invite_tokens")
}
