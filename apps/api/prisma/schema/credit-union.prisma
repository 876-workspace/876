// CreditUnion — table `credit_unions`.
// Module: directory. Directory reference data: institutions, branches, schools, and agencies.

model CreditUnion {
  id                  String              @id @db.VarChar
  /** Stable lowercase slug; the seed's idempotent upsert key. */
  code                String?             @unique @db.VarChar
  name                String              @db.VarChar
  shortName           String?             @map("short_name") @db.VarChar
  logoUrl             String?             @map("logo_url") @db.VarChar
  headquarters        String?             @db.VarChar
  website             String?             @db.VarChar
  generalPhone        String?             @map("general_phone") @db.VarChar
  supportPhone        String?             @map("support_phone") @db.VarChar
  supportEmail        String?             @map("support_email") @db.VarChar
  complaintsEmail     String?             @map("complaints_email") @db.VarChar
  contactUrl          String?             @map("contact_url") @db.VarChar
  sourceUrl           String?             @map("source_url") @db.VarChar
  sourceAsOf          String?             @map("source_as_of") @db.VarChar(10)
  lastVerifiedAt      BigInt?             @map("last_verified_at")
  deletedAt           BigInt?             @map("deleted_at")
  deletedBy           String?             @map("deleted_by") @db.VarChar
  deletionReason      String?             @map("deletion_reason")
  createdAt           BigInt              @map("created_at")
  updatedAt           BigInt              @map("updated_at")
  creditUnionBranches CreditUnionBranch[]

  @@map("credit_unions")
}
