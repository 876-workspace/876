// Bank — table `banks`.
// Module: directory. Shared financial-institution reference data. A bank code is
// meaningful only inside a country's clearing system, so it is never treated as
// a globally unique identifier.

model Bank {
  id              String        @id @db.VarChar
  countryCode     String        @map("country_code") @db.VarChar(2)
  name            String        @db.VarChar
  shortName       String?       @map("short_name") @db.VarChar
  bankCode        String        @map("bank_code") @db.VarChar
  clearingSystem  String?       @map("clearing_system") @db.VarChar
  institutionType String        @default("commercial_bank") @map("institution_type") @db.VarChar
  swiftCode       String?       @map("swift_code") @db.VarChar
  logoUrl         String?       @map("logo_url") @db.VarChar
  headOffice      String?       @map("head_office") @db.VarChar
  website         String?       @db.VarChar
  generalPhone    String?       @map("general_phone") @db.VarChar
  supportPhone    String?       @map("support_phone") @db.VarChar
  supportEmail    String?       @map("support_email") @db.VarChar
  complaintsEmail String?       @map("complaints_email") @db.VarChar
  contactUrl      String?       @map("contact_url") @db.VarChar
  sourceUrl       String?       @map("source_url") @db.VarChar
  /** Source publication date (YYYY-MM-DD), copied from the cited source. */
  sourceAsOf      String?       @map("source_as_of") @db.VarChar(10)
  /** Unix seconds; null until a human verifies the record against its source. */
  lastVerifiedAt  BigInt?       @map("last_verified_at")
  deletedAt       BigInt?       @map("deleted_at")
  deletedBy       String?       @map("deleted_by") @db.VarChar
  deletionReason  String?       @map("deletion_reason")
  createdAt       BigInt        @map("created_at")
  updatedAt       BigInt        @map("updated_at")

  country      Country       @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  bankAccounts BankAccount[]
  bankBranches BankBranch[]

  @@unique([countryCode, bankCode], map: "banks_country_code_bank_code_key")
  @@index([countryCode, name], map: "ix_banks_country_name")
  @@map("banks")
}
