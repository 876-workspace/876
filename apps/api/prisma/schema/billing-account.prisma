// BillingAccount — table `billing_accounts`.
// Module: billing. References into the Billing bounded context: account mirrors, the customer
// outbox, provider object mirrors, and the finance-provisioning outbox. The
// financial records themselves live in apps/billing-api.

model BillingAccount {
  id                     String         @id @db.VarChar
  organizationId         String         @map("organization_id") @db.VarChar
  name                   String?        @db.VarChar
  email                  String?        @db.VarChar
  invoiceEmail           String?        @map("invoice_email") @db.VarChar
  currency               String?        @default("JMD") @db.VarChar(3)
  taxExempt              String?        @map("tax_exempt") @db.VarChar
  balance                BigInt         @default(0)
  defaultPaymentMethodId String?        @map("default_payment_method_id") @db.VarChar
  invoiceSettings        Json?          @map("invoice_settings") @db.Json
  preferredLocales       Json?          @map("preferred_locales") @db.Json
  address                Json?          @db.Json
  shipping               Json?          @db.Json
  metadata               Json?          @db.Json
  createdAt              BigInt         @map("created_at")
  updatedAt              BigInt         @map("updated_at")
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscriptions          Subscription[]

  @@index([organizationId], map: "ix_billing_accounts_organization_id")
  @@map("billing_accounts")
}
