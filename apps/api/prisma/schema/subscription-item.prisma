// SubscriptionItem — table `subscription_items`.
// Module: subscriptions. Org to platform-app entitlements (the `subscriptions` table) and their items.

model SubscriptionItem {
  id                String       @id @db.VarChar
  subscriptionId    String       @map("subscription_id") @db.VarChar
  priceId           String       @map("price_id") @db.VarChar
  quantity          Int          @default(1)
  billingThresholds Json?        @map("billing_thresholds") @db.Json
  metadata          Json?        @db.Json
  createdAt         BigInt       @map("created_at")
  updatedAt         BigInt       @map("updated_at")
  price             Price        @relation(fields: [priceId], references: [id], onUpdate: NoAction)
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([priceId], map: "ix_subscription_items_price_id")
  @@index([subscriptionId], map: "ix_subscription_items_subscription_id")
  @@map("subscription_items")
}
