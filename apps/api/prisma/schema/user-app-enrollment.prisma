// UserAppEnrollment — table `user_app_enrollments`.
// Module: apps. Registered apps, API keys, app assignments, and per-user app enrollment.

model UserAppEnrollment {
  id         String @id @db.VarChar
  userId     String @map("user_id") @db.VarChar
  appId      String @map("app_id") @db.VarChar
  enrolledAt BigInt @map("enrolled_at")
  lastSeenAt BigInt @map("last_seen_at")
  app        App    @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, appId])
  @@index([appId], map: "ix_user_app_enrollments_app_id")
  @@index([userId], map: "ix_user_app_enrollments_user_id")
  @@map("user_app_enrollments")
}
