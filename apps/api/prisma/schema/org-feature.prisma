// OrgFeature — table `org_features`.
// Module: features. Feature-flag registry, per-org and per-user grants, and provider sync state.

model OrgFeature {
  id             String       @id @db.VarChar
  organizationId String       @map("organization_id") @db.VarChar
  featureId      String       @map("feature_id") @db.VarChar
  status         String       @default("enabled") @db.VarChar
  note           String?      @db.VarChar
  syncedAt       BigInt       @map("synced_at")
  createdAt      BigInt       @map("created_at")
  updatedAt      BigInt       @map("updated_at")
  feature        Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, featureId])
  @@map("org_features")
}
