// AuthorizationCode — table `authorization_codes`.
// Module: auth. Sessions, auth providers, OAuth grants/codes/tokens, SSO, OTP, and login attempts.

model AuthorizationCode {
  id                  String        @id @db.VarChar
  codeHash            String        @unique @map("code_hash") @db.VarChar
  userId              String        @map("user_id") @db.VarChar
  appId               String        @map("app_id") @db.VarChar
  orgId               String?       @map("org_id") @db.VarChar
  redirectUri         String        @map("redirect_uri") @db.VarChar
  codeChallenge       String        @map("code_challenge") @db.VarChar
  codeChallengeMethod String        @default("S256") @map("code_challenge_method") @db.VarChar
  scope               String        @db.VarChar
  state               String?       @db.VarChar
  nonce               String?       @db.VarChar
  authTime            BigInt        @map("auth_time")
  expiresAt           BigInt        @map("expires_at")
  usedAt              BigInt?       @map("used_at")
  createdAt           BigInt        @map("created_at")
  app                 App           @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization        Organization? @relation(fields: [orgId], references: [id], onUpdate: NoAction)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("authorization_codes")
}
