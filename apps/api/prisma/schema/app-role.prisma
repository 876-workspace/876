// AppRole — table `app_roles`.
// Module: app-access. Platform role templates and organization-scoped app roles.

model AppRole {
  id             String          @id @db.VarChar
  appId          String          @map("app_id") @db.VarChar
  organizationId String?         @map("organization_id") @db.VarChar
  key            String          @db.VarChar
  name           String          @db.VarChar
  description    String?
  permissions    String[]        @default([]) @db.VarChar
  isSystem       Boolean         @default(false) @map("is_system")
  isDefault      Boolean         @default(false) @map("is_default")
  templateKey    String?         @map("template_key") @db.VarChar
  position       Int             @default(0)
  deletedAt      BigInt?         @map("deleted_at")
  deletedBy      String?         @map("deleted_by") @db.VarChar
  deletionReason String?         @map("deletion_reason")
  createdAt      BigInt          @map("created_at")
  updatedAt      BigInt          @map("updated_at")
  app            App             @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appAssignments AppAssignment[]

  @@unique([appId, organizationId, key])
  @@index([appId], map: "ix_app_roles_app_id")
  @@index([organizationId], map: "ix_app_roles_organization_id")
  @@map("app_roles")
}
