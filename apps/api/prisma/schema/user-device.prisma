// UserDevice — table `user_devices`.
// Module: devices. User device registry and session telemetry.

model UserDevice {
  id              String        @id @db.VarChar
  userId          String        @map("user_id") @db.VarChar
  fingerprint     String        @db.VarChar
  confidence      String        @default("low") @db.VarChar
  deviceType      String        @default("other") @map("device_type") @db.VarChar
  deviceBrand     String?       @map("device_brand") @db.VarChar
  deviceModel     String?       @map("device_model") @db.VarChar
  osName          String?       @map("os_name") @db.VarChar
  osVersion       String?       @map("os_version") @db.VarChar
  browserName     String?       @map("browser_name") @db.VarChar
  browserVersion  String?       @map("browser_version") @db.VarChar
  isBot           Boolean       @default(false) @map("is_bot")
  label           String?       @db.VarChar
  trusted         Boolean       @default(false)
  trustedAt       BigInt?       @map("trusted_at")
  trustedBy       String?       @map("trusted_by") @db.VarChar
  blockedAt       BigInt?       @map("blocked_at")
  blockedBy       String?       @map("blocked_by") @db.VarChar
  blockReason     String?       @map("block_reason")
  firstSeenAt     BigInt        @map("first_seen_at")
  lastSeenAt      BigInt        @map("last_seen_at")
  lastIp          String?       @map("last_ip") @db.VarChar
  lastCountryCode String?       @map("last_country_code") @db.VarChar(2)
  signInCount     Int           @default(0) @map("sign_in_count")
  signal          Json?         @db.Json
  createdAt       BigInt        @map("created_at")
  updatedAt       BigInt        @map("updated_at")
  authAttempts    AuthAttempt[]
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, fingerprint])
  @@index([fingerprint], map: "ix_user_devices_fingerprint")
  @@index([userId], map: "ix_user_devices_user_id")
  @@index([userId, lastSeenAt], map: "ix_user_devices_user_last_seen")
  @@map("user_devices")
}
