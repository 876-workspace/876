// ProvisioningResource — table `provisioning_resources`.
// Module: provisioning. Provisioning manifests, revisions, resources, properties, steps, and runs.

model ProvisioningResource {
  id                           String                       @id @db.VarChar
  revisionId                   String                       @map("revision_id") @db.VarChar
  resourceType                 String                       @map("resource_type") @db.VarChar
  key                          String                       @db.VarChar
  position                     Int
  createdAt                    BigInt                       @map("created_at")
  updatedAt                    BigInt                       @map("updated_at")
  provisioningProperties       ProvisioningProperty[]
  provisioningManifestRevision ProvisioningManifestRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([revisionId, position])
  @@unique([revisionId, resourceType, key])
  @@index([revisionId], map: "ix_provisioning_resources_revision_id")
  @@map("provisioning_resources")
}
