// AppAssignment — table `app_assignments`.
// Module: app-access. Per-member app entitlement profile and lifecycle.

model AppAssignment {
  id               String       @id @db.VarChar
  organizationId   String       @map("organization_id") @db.VarChar
  userId           String       @map("user_id") @db.VarChar
  appId            String       @map("app_id") @db.VarChar
  appRoleId        String?      @map("app_role_id") @db.VarChar
  status           String       @default("active") @db.VarChar
  permissionGrants String[]     @default([]) @map("permission_grants") @db.VarChar
  permissionDenies String[]     @default([]) @map("permission_denies") @db.VarChar
  title            String?      @db.VarChar
  attributes       Json?        @db.Json
  assignedBy       String?      @map("assigned_by") @db.VarChar
  assignedAt       BigInt?      @map("assigned_at")
  lastAccessAt     BigInt?      @map("last_access_at")
  revokedAt        BigInt?      @map("revoked_at")
  revokedBy        String?      @map("revoked_by") @db.VarChar
  deletedAt        BigInt?      @map("deleted_at")
  deletedBy        String?      @map("deleted_by") @db.VarChar
  deletionReason   String?      @map("deletion_reason")
  createdAt        BigInt       @map("created_at")
  updatedAt        BigInt       @map("updated_at")
  app              App          @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appRole          AppRole?     @relation(fields: [appRoleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, userId, appId])
  @@index([appId], map: "ix_app_assignments_app_id")
  @@index([appRoleId], map: "ix_app_assignments_app_role_id")
  @@index([organizationId], map: "ix_app_assignments_organization_id")
  @@index([userId], map: "ix_app_assignments_user_id")
  @@map("app_assignments")
}
