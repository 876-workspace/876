// UserIdentification — table `user_identifications`.
// Module: users. User accounts, profiles, emails, mobile numbers, PINs, and identifications.

model UserIdentification {
  id              String  @id @db.VarChar
  userId          String  @map("user_id") @db.VarChar
  type            String  @db.VarChar
  value           String  @db.VarChar
  countryCode     String? @map("country_code") @db.VarChar(2)
  verified        Boolean @default(false)
  verifiedAt      BigInt? @map("verified_at")
  verifiedBy      String? @map("verified_by") @db.VarChar
  deletedAt       BigInt? @map("deleted_at")
  deletedBy       String? @map("deleted_by") @db.VarChar
  deletionReason  String? @map("deletion_reason")
  createdAt       BigInt  @map("created_at")
  updatedAt       BigInt  @map("updated_at")
  valueCiphertext String? @map("value_ciphertext")
  valueKeyId      String? @map("value_key_id") @db.VarChar
  valueProvider   String? @map("value_provider") @db.VarChar
  valueLast4      String? @map("value_last4") @db.VarChar(4)
  valueHash       String? @map("value_hash") @db.VarChar
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, type], map: "uq_user_identifications_user_type_active", where: raw("(deleted_at IS NULL)"))
  @@index([userId], map: "ix_user_identifications_user_id")
  @@index([valueHash], map: "ix_user_identifications_value_hash")
  @@map("user_identifications")
}
