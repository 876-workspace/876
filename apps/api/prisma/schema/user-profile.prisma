// UserProfile — table `user_profiles`.
// Module: users. User accounts, profiles, emails, mobile numbers, PINs, and identifications.

model UserProfile {
  id          String   @id @db.VarChar
  userId      String   @unique @map("user_id") @db.VarChar
  bio         String?
  displayName String?  @map("display_name") @db.VarChar
  nickname    String?  @db.VarChar
  gender      String?  @db.VarChar
  dateOfBirth String?  @map("date_of_birth") @db.VarChar
  language    String?  @db.VarChar
  timezone    String?  @db.VarChar
  countryCode String?  @map("country_code") @db.VarChar(2)
  phoneNumber String?  @map("phone_number") @db.VarChar
  website     String?  @db.VarChar
  location    String?  @db.VarChar
  createdAt   BigInt   @map("created_at")
  updatedAt   BigInt   @map("updated_at")
  country     Country? @relation(fields: [countryCode], references: [code], onUpdate: NoAction)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_profiles")
}
