// ProvisioningProperty — table `provisioning_properties`.
// Module: provisioning. Provisioning manifests, revisions, resources, properties, steps, and runs.

model ProvisioningProperty {
  id                   String               @id @db.VarChar
  resourceId           String               @map("resource_id") @db.VarChar
  key                  String               @db.VarChar
  valueType            String               @map("value_type") @db.VarChar
  stringValue          String?              @map("string_value")
  integerValue         BigInt?              @map("integer_value")
  decimalValue         Decimal?             @map("decimal_value") @db.Decimal(24, 8)
  booleanValue         Boolean?             @map("boolean_value")
  referenceNamespace   String?              @map("reference_namespace") @db.VarChar
  referenceKey         String?              @map("reference_key") @db.VarChar
  createdAt            BigInt               @map("created_at")
  updatedAt            BigInt               @map("updated_at")
  provisioningResource ProvisioningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([resourceId, key])
  @@index([resourceId], map: "ix_provisioning_properties_resource_id")
  @@map("provisioning_properties")
}
