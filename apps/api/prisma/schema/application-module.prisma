// ApplicationModule — table `application_modules`.
// Module: modules. Org-level module enablement.

model ApplicationModule {
  id          String       @id @db.VarChar
  appId       String       @map("app_id") @db.VarChar
  key         String       @db.VarChar
  name        String       @db.VarChar
  description String?
  featureId   String?      @map("feature_id") @db.VarChar
  status      String       @default("active") @db.VarChar
  position    Int          @default(0)
  createdAt   BigInt       @map("created_at")
  updatedAt   BigInt       @map("updated_at")
  app         App          @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  feature     Feature?     @relation(fields: [featureId], references: [id], onUpdate: NoAction)
  planModules PlanModule[]

  @@unique([appId, key])
  @@unique([appId, featureId], map: "uq_application_modules_app_feature", where: raw("(feature_id IS NOT NULL)"))
  @@index([appId], map: "ix_application_modules_app_id")
  @@index([featureId], map: "ix_application_modules_feature_id")
  @@map("application_modules")
}
