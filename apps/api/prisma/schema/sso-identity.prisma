// SsoIdentity — table `sso_identities`.
// Module: auth. Sessions, auth providers, OAuth grants/codes/tokens, SSO, OTP, and login attempts.

model SsoIdentity {
  id                 String         @id @db.VarChar
  userId             String         @map("user_id") @db.VarChar
  providerId         String         @map("provider_id") @db.VarChar
  connectionId       String?        @map("connection_id") @db.VarChar
  externalIdentityId String         @map("external_identity_id") @db.VarChar
  externalUserId     String?        @map("external_user_id") @db.VarChar
  email              String?        @db.VarChar
  username           String?        @db.VarChar
  displayName        String?        @map("display_name") @db.VarChar
  rawProviderData    Json?          @map("raw_provider_data") @db.Json
  lastSyncedAt       BigInt?        @map("last_synced_at")
  createdAt          BigInt         @map("created_at")
  updatedAt          BigInt         @map("updated_at")
  ssoConnection      SsoConnection? @relation(fields: [connectionId], references: [id], onUpdate: NoAction)
  authProvider       AuthProvider   @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([providerId, externalIdentityId])
  @@map("sso_identities")
}
