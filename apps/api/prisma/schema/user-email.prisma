// UserEmail — table `user_emails`.
// Module: users. User accounts, profiles, emails, mobile numbers, PINs, and identifications.

model UserEmail {
  id                 String        @id @db.VarChar
  userId             String        @map("user_id") @db.VarChar
  email              String        @unique @db.VarChar
  isPrimary          Boolean       @default(false) @map("is_primary")
  verificationStatus String        @default("unverified") @map("verification_status") @db.VarChar
  verificationId     String?       @map("verification_id") @db.VarChar
  verifiedAt         BigInt?       @map("verified_at")
  createdAt          BigInt        @map("created_at")
  updatedAt          BigInt        @map("updated_at")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  verification       Verification? @relation(fields: [verificationId], references: [id], onUpdate: NoAction)

  @@map("user_emails")
}
