// OrganizationRole — table `organization_roles`.
// Module: organizations. Organizations, memberships, org roles, locations, contacts, and departments.

model OrganizationRole {
  id             String       @id @db.VarChar
  organizationId String       @map("organization_id") @db.VarChar
  name           String       @db.VarChar
  displayName    String       @map("display_name") @db.VarChar
  description    String?
  permissions    String[]     @default([]) @db.VarChar
  isSystem       Boolean      @default(false) @map("is_system")
  createdAt      BigInt       @map("created_at")
  updatedAt      BigInt       @map("updated_at")
  memberships    Membership[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, name])
  @@index([organizationId], map: "ix_organization_roles_organization_id")
  @@map("organization_roles")
}
