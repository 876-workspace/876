{
  "name": "@876/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local src/seeds/cli.ts",
    "provisioning:import": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local scripts/import-provisioning.ts",
    "generate": "node scripts/prisma-generate.mjs",
    "node:dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local src/server.ts",
    "node:build": "tsup",
    "node:start": "node dist/server.js",
    "node:typecheck": "tsc --noEmit",
    "node:test": "vitest run",
    "node:test:watch": "vitest",
    "node:lint": "eslint src",
    "node:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "node:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local src/seeds/cli.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/guard-migrate.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:baseline": "tsx scripts/baseline-database.ts",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:drift": "prisma migrate diff --from-schema prisma/schema --to-config-datasource --script",
    "prebuild": "pnpm generate",
    "pretypecheck": "pnpm generate",
    "pretest": "pnpm generate",
    "predev": "pnpm generate"
  },
  "dependencies": {
    "@876/core": "workspace:*",
    "@876/server": "workspace:*",
    "@876/work": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@prisma/extension-accelerate": "3.0.1",
    "@sentry/node": "10.70.0",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.1",
    "jose": "6.2.9",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "posthog-node": "5.49.1",
    "stripe": "22.5.0",
    "zod": "4.4.3",
    "zod-openapi": "6.0.1"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.2.0",
    "dotenv": "17.4.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
