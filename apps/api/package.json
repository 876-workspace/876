{
  "name": "@876/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": ".venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 4000 --reload --reload-include '.env' --reload-include '.env.*'",
    "db:bootstrap": ".venv/bin/python scripts/bootstrap.py",
    "build": "[ -x .venv/bin/python ] && .venv/bin/python -m compileall -q . || echo 'skip api build (no venv)'",
    "start": ".venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port ${PORT:-4000}",
    "typecheck": ".venv/bin/python -m mypy --explicit-package-bases api core db domains providers schemas services utils main.py",
    "test": ".venv/bin/python -m pytest",
    "lint": ".venv/bin/python -m ruff check .",
    "format": ".venv/bin/python -m ruff format .",
    "format:check": ".venv/bin/python -m ruff format --check .",
    "node:dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local src/server.ts",
    "node:build": "tsup",
    "node:start": "node dist/server.js",
    "node:typecheck": "tsc --noEmit",
    "node:test": "vitest run",
    "node:test:watch": "vitest",
    "node:lint": "eslint src",
    "node:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/guard-migrate.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:drift": "prisma migrate diff --from-schema prisma/schema --to-config-datasource --script",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "@sentry/node": "10.69.0",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "jose": "6.2.8",
    "pg": "8.13.1",
    "pino": "10.3.1",
    "stripe": "22.4.0",
    "zod": "4.4.3",
    "zod-openapi": "6.0.0"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "25.6.2",
    "@types/pg": "8.11.10",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.1.1",
    "dotenv": "16.4.7",
    "pino-pretty": "13.1.3",
    "prisma": "7.7.0",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "vitest": "4.1.5",
    "wrangler": "4.113.0"
  }
}
