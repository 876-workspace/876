# FastAPI API (@876/api) — runs on PORT, owns the database + WorkOS server client.
PORT=4000

# WorkOS server credentials (API-only — never in Next.js apps).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Access-token verification (JWKS). Leave blank to use WorkOS default for the client id.
WORKOS_JWKS_URL=

# Configure stable RS256 OAuth signing keys in every environment.
OAUTH_PRIVATE_KEY=
OAUTH_KEY_ID=876-local

# Shared secret for trusted server-to-server calls (AdminDep). Must match
# API_INTERNAL_KEY in both Next.js apps.
API_INTERNAL_KEY=

# Prisma Accelerate runtime URL (prisma://...).
DATABASE_URL=
# Direct PostgreSQL URL used only by Prisma CLI commands (migrate, db pull,
# Studio, and generate). Never expose either value to the browser.
DIRECT_DATABASE_URL=

# Comma-separated browser origins allowed to call the API.
# On GitHub Codespaces, setup-env.mjs writes .env.development.local with
# the forwarded-port URLs — no need to set this manually there.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# PostHog feature-flag management. The personal key stays server-side.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=0
POSTHOG_HOST=https://us.i.posthog.com

# Sentry error reporting; set this DSN with `wrangler secret put` at deploy time.
SENTRY_DSN=https://5eae615bbf71103685497986d2abd604@o4507681618591744.ingest.us.sentry.io/4511802778648576
LOG_LEVEL=info
ENVIRONMENT=development

# Set to true when running behind HTTPS in development (e.g. Gitpod, Codespaces).
# Browsers silently drop non-Secure cookies over HTTPS, breaking session persistence.
# Defaults to IS_PRODUCTION when unset.
COOKIE_SECURE=

# The account with this email is bootstrapped as the platform owner (leave empty to disable).
PLATFORM_OWNER_EMAIL=

# Browser-facing Billing application origin used by first-party app seeding.
BILLING_URL=http://localhost:3004
# Standalone Billing API origin used by finance delivery and scheduled runs.
BILLING_API_URL=http://localhost:4004
# Shared service credential used only for the durable Core-to-Billing finance
# provisioning outbox. It must match Billing's BILLING_INTERNAL_KEY.
BILLING_INTERNAL_KEY=
FINANCE_PROVISIONING_POLL_SECONDS=30
FINANCE_PROVISIONING_BATCH_SIZE=25

# Twilio communications. All capabilities are disabled by default.
TWILIO_MODE=disabled
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VOICE_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_LOOKUP_ENABLED=false
TWILIO_VERIFY_SMS_ENABLED=false
TWILIO_VERIFY_CALL_ENABLED=false
TWILIO_VERIFY_WHATSAPP_ENABLED=false
TWILIO_SMS_ENABLED=false
TWILIO_WHATSAPP_ENABLED=false
TWILIO_VOICE_ENABLED=false
