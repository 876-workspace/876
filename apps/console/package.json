{
  "name": "@876/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma migrate deploy && pnpm build:sw && next dev --turbopack --port 3002",
    "build:sw": "node ../../scripts/build-serwist.mjs",
    "build": "pnpm build:next",
    "build:next": "pnpm build:sw && NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start --port ${PORT:-3002}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:db": "tsc --noEmit -p prisma",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo .open-next .wrangler",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill": "tsx prisma/backfill.ts"
  },
  "dependencies": {
    "@876/admin": "workspace:*",
    "@876/analytics": "workspace:*",
    "@876/billing": "workspace:*",
    "@876/client": "workspace:*",
    "@876/core": "workspace:*",
    "@876/couriers": "workspace:*",
    "@876/editor": "workspace:*",
    "@876/sdk": "workspace:*",
    "@876/ui": "workspace:*",
    "@876/widgets": "workspace:*",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@prisma/extension-accelerate": "3.0.1",
    "@sentry/nextjs": "10.56.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-table": "^9.1.2",
    "@uploadthing/react": "7.3.3",
    "@workos-inc/node": "10.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "iron-session": "8.0.4",
    "motion": "13.1.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "uploadthing": "7.7.4",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "pg": "8.23.0",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
