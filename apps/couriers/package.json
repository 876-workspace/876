{
  "name": "@876/couriers-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:sw && next dev --turbopack --port 3003",
    "build:sw": "node ../../scripts/build-serwist.mjs",
    "build": "pnpm build:sw && opennextjs-cloudflare build",
    "build:next": "pnpm build:sw && NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start --port ${PORT:-3003}",
    "lint": "eslint",
    "boundaries": "../api/node_modules/.bin/depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo .open-next .wrangler",
    "cf:build": "pnpm build:sw && opennextjs-cloudflare build",
    "preview": "pnpm build:sw && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm build:sw && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "pnpm build:sw && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@876/analytics": "workspace:*",
    "@876/billing": "workspace:*",
    "@876/client": "workspace:*",
    "@876/core": "workspace:*",
    "@876/couriers": "workspace:*",
    "@876/sdk": "workspace:*",
    "@876/settings": "workspace:*",
    "@876/storage": "workspace:*",
    "@876/ui": "workspace:*",
    "@876/widgets": "workspace:*",
    "@opennextjs/cloudflare": "1.20.2",
    "@sentry/nextjs": "10.70.0",
    "@tanstack/react-table": "^9.1.2",
    "next": "16.3.1",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "wrangler": "4.124.0"
  }
}
