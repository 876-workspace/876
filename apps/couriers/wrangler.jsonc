{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "876-couriers",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "876-couriers",
    },
  ],
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }],
  // Non-secret service URLs. Secrets are set with `wrangler secret put`.
  "vars": {
    "API_URL": "https://876-api.raheemforschool.workers.dev",
    "WIDGETS_API_URL": "https://876-widgets-api.raheemforschool.workers.dev",
    "BILLING_URL": "https://876-billing.raheemforschool.workers.dev",
    "BILLING_API_URL": "https://876-billing-api.raheemforschool.workers.dev",
    "SENTRY_DSN": "https://34e105d78c6616375353e169b8cd28fd@o4507681618591744.ingest.us.sentry.io/4511802776223744",
    "NEXT_PUBLIC_SENTRY_DSN": "https://34e105d78c6616375353e169b8cd28fd@o4507681618591744.ingest.us.sentry.io/4511802776223744",
  },
  "observability": {
    "enabled": true,
  },
}
