{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "876-couriers",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild's `keepNames` helper, which wrangler turns on by default, rewrites
  // every function in the bundle to call `__name(fn, "fn")`. Next serialises
  // some functions into the HTML by calling `.toString()` on them — next-themes'
  // no-flash theme script is one — so the `__name` call travels to the browser,
  // where the helper does not exist and the script dies with
  // `ReferenceError: __name is not defined` on every page load.
  // Names are only lost for symbols esbuild had to rename for collisions, whose
  // `.name` carried no meaning anyway.
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "876-couriers",
    },
  ],
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }],
  // Non-secret service URLs. Secrets are set with `wrangler secret put`.
  "vars": {
    "API_URL": "https://876-api.1876.workers.dev",
    "WIDGETS_API_URL": "https://876-widgets-api.1876.workers.dev",
    "BILLING_URL": "https://876-billing.1876.workers.dev",
    "BILLING_API_URL": "https://876-billing-api.1876.workers.dev",
    "STORAGE_API_URL": "https://876-storage-api.1876.workers.dev",
    "SENTRY_DSN": "https://34e105d78c6616375353e169b8cd28fd@o4507681618591744.ingest.us.sentry.io/4511802776223744",
    "NEXT_PUBLIC_SENTRY_DSN": "https://34e105d78c6616375353e169b8cd28fd@o4507681618591744.ingest.us.sentry.io/4511802776223744",
  },
  "observability": {
    "enabled": true,
  },
}
