/// A tenant-owned office / customer pickup location.
///
/// A branch is an operational entity, not an address: its name, phone, default
/// and active state, settings, assigned customers, routed packages and staff all
/// belong here, and the address it occupies is one property of it. Customers are
/// assigned a home branch at enrollment; packages are routed there by default.
/// isDefault marks the primary branch shown during onboarding and signup flows.
/// settings is a schemaless JSONB bag for future branch-level config (e.g.
/// delivery options, pickup hours) — structure is defined by the application
/// layer, not enforced here.
model Branch {
  id        String  @id @default(cuid())
  tenantId  String  @map("tenant_id")
  addressId String  @unique @map("address_id")
  /// The core 876 organization location this site is mirrored to. Opaque id,
  /// no cross-database foreign key. Null when the mirror has not yet
  /// succeeded — the site is fully usable either way.
  orgLocationId String? @unique @map("org_location_id")
  name      String
  phone     String?
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")
  /// Schemaless branch configuration. Structure defined by application layer.
  settings  Json?
  createdAt Int     @map("created_at")
  updatedAt Int     @map("updated_at")

  tenant    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  address   Address                  @relation(fields: [addressId, tenantId], references: [id, tenantId], onDelete: NoAction)
  customers CourierCustomerProfile[]
  packages  Package[]
  staff     StaffMember[]

  @@unique([tenantId, name], name: "branches_tenant_id_name_key")
  @@index([tenantId], name: "branches_tenant_id_idx")
  @@map("branches")
}
