{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "sourceMap": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // `prisma/` holds Node-only maintenance scripts (seed) that import the
  // gitignored `prisma-node` client. They are not part of the Next.js app, and
  // `next build` type-checks everything in `include` — on a clean CI checkout
  // (Cloudflare Workers Builds) that client does not exist and the build fails.
  // Check them on demand with `pnpm typecheck:db`.
  "exclude": ["node_modules", "prisma"]
}
