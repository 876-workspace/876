model Tenant {
  id              String   @id
  organizationId  String   @unique @map("organization_id")
  triageProjectId String?  @map("triage_project_id")
  presetKey       String   @default("software-development") @map("preset_key")
  createdAt       BigInt   @map("created_at")
  updatedAt       BigInt   @map("updated_at")

  projects Project[]
  issues   Issue[]
  issueRelations IssueRelation[]
  issueDependencies IssueDependency[]
  labels   Label[]
  comments Comment[]
  events   IssueEvent[]
  workItemTypes WorkItemType[]
  workflowStates WorkflowState[]
  milestones Milestone[]
  milestoneComments MilestoneComment[]
  milestoneEvents MilestoneEvent[]
  cycles Cycle[]
  taskLists TaskList[]
  customFields CustomField[]
  customFieldValues CustomFieldValue[]
  milestoneCustomFields MilestoneCustomField[]
  milestoneCustomFieldValues MilestoneCustomFieldValue[]
  baselines ProjectBaseline[]
  baselineItems ProjectBaselineItem[]

  @@map("projects_tenants")
}
