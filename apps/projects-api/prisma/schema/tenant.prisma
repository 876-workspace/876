model Tenant {
  id              String   @id
  organizationId  String   @unique @map("organization_id")
  triageProjectId String?  @map("triage_project_id")
  presetKey       String   @default("software-development") @map("preset_key")
  createdAt       BigInt   @map("created_at")
  updatedAt       BigInt   @map("updated_at")

  projects Project[]
  issues   Issue[]
  issueRelations IssueRelation[]
  issueDependencies IssueDependency[]
  labels   Label[]
  comments Comment[]
  events   IssueEvent[]
  workItemTypes WorkItemType[]
  workflowStates WorkflowState[]
  milestones Milestone[]
  milestoneComments MilestoneComment[]
  milestoneEvents MilestoneEvent[]
  cycles Cycle[]
  taskLists TaskList[]
  customFields CustomField[]
  customFieldValues CustomFieldValue[]
  milestoneCustomFields MilestoneCustomField[]
  milestoneCustomFieldValues MilestoneCustomFieldValue[]
  projectCustomFields ProjectCustomField[]
  projectCustomFieldValues ProjectCustomFieldValue[]
  layouts Layout[]
  workflowTransitions WorkflowTransition[]
  automationRules AutomationRule[]
  automationEvents AutomationEvent[]
  automationRuns AutomationRun[]
  notifications Notification[]
  baselines ProjectBaseline[]
  baselineItems ProjectBaselineItem[]
  projectEventLinks ProjectEventLink[]
  timeEntries TimeEntry[]
  timesheets Timesheet[]
  timesheetEvents TimesheetEvent[]
  projectBillings ProjectBilling[]
  budgets Budget[]
  rates Rate[]
  memberCapacities MemberCapacity[]
  projectTemplates ProjectTemplate[]
  projectTemplateVersions ProjectTemplateVersion[]
  projectTemplateInstantiations ProjectTemplateInstantiation[]
  followers Follower[]
  discussions Discussion[]
  discussionPosts DiscussionPost[]
  discussionPostEdits DiscussionPostEdit[]
  wikiPages WikiPage[]
  wikiRevisions WikiRevision[]
  clientGrants ClientGrant[]
  attachmentLinks AttachmentLink[]
  customModules CustomModule[]
  customModuleFields CustomModuleField[]
  customModuleStatuses CustomModuleStatus[]
  customModuleRecords CustomModuleRecord[]
  customModuleRecordValues CustomModuleRecordValue[]
  customModuleLinks CustomModuleLink[]
  dashboardWidgets DashboardWidget[]
  integrationClients IntegrationClient[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  importJobs ImportJob[]
  importJobRows ImportJobRow[]
  developmentLinks WorkItemDevelopmentLink[]

  @@map("projects_tenants")
}
