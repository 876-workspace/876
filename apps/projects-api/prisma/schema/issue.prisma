model Issue {
  id             String  @id
  tenantId       String  @map("tenant_id")
  projectId      String  @map("project_id")
  number         Int
  identifier     String                        // "CONSOLE-12"
  title          String
  description    String?
  status         String  @default("todo")      // backlog|todo|in-progress|in-review|done|canceled
  workflowStateId String? @map("workflow_state_id")
  typeKey        String  @default("task") @map("type_key")
  workItemTypeId String? @map("work_item_type_id")
  milestoneId    String? @map("milestone_id")
  taskListId     String? @map("task_list_id")
  cycleId        String? @map("cycle_id")
  priority       String  @default("none")      // none|low|medium|high|urgent
  assigneeUserId String? @map("assignee_user_id")
  creatorUserId  String? @map("creator_user_id")
  parentIssueId  String? @map("parent_issue_id")
  estimate       Int?
  dueDate        BigInt? @map("due_date")
  plannedStartDate BigInt? @map("planned_start_date")
  plannedFinishDate BigInt? @map("planned_finish_date")
  plannedDurationMinutes Int? @map("planned_duration_minutes")
  position       Int     @default(0)
  clientVisible  Boolean @default(false) @map("client_visible")
  startedAt      BigInt? @map("started_at")
  completedAt    BigInt? @map("completed_at")
  canceledAt     BigInt? @map("canceled_at")
  deletedAt      BigInt? @map("deleted_at")
  createdAt      BigInt  @map("created_at")
  updatedAt      BigInt  @map("updated_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Issue?       @relation("IssueSubIssues", fields: [parentIssueId], references: [id], onDelete: SetNull)
  children Issue[]      @relation("IssueSubIssues")
  labels   IssueLabel[]
  comments Comment[]
  events   IssueEvent[]
  workflowState WorkflowState? @relation(fields: [workflowStateId], references: [id], onDelete: Restrict)
  workItemType WorkItemType? @relation(fields: [workItemTypeId], references: [id], onDelete: Restrict)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  taskList TaskList? @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  cycle Cycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  customFieldValues CustomFieldValue[]
  sourceRelations IssueRelation[] @relation("IssueRelationSource")
  targetRelations IssueRelation[] @relation("IssueRelationTarget")
  predecessorLinks IssueDependency[] @relation("IssueDependencyPredecessor")
  successorLinks IssueDependency[] @relation("IssueDependencySuccessor")
  baselineItems ProjectBaselineItem[]
  projectEvents ProjectEvent[]
  timeEntries TimeEntry[]

  @@unique([tenantId, identifier])
  @@unique([projectId, number])
  @@index([tenantId, status])
  @@index([tenantId, assigneeUserId])
  @@index([tenantId, updatedAt])
  @@index([projectId, status])
  @@index([tenantId, milestoneId])
  @@index([tenantId, taskListId])
  @@index([projectId, taskListId])
  @@map("projects_issues")
}

model Comment {
  id           String  @id
  tenantId     String  @map("tenant_id")
  issueId      String  @map("issue_id")
  authorUserId String? @map("author_user_id")
  body         String
  clientVisible Boolean @default(false) @map("client_visible")
  deletedAt    BigInt? @map("deleted_at")
  createdAt    BigInt  @map("created_at")
  updatedAt    BigInt  @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issue  Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@map("projects_comments")
}

model IssueEvent {
  id          String  @id
  tenantId    String  @map("tenant_id")
  issueId     String  @map("issue_id")
  actorUserId String? @map("actor_user_id")
  type        String
  fromValue   String? @map("from_value")
  toValue     String? @map("to_value")
  createdAt   BigInt  @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issue  Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@map("projects_issue_events")
}

model IssueRelation {
  id            String @id
  tenantId      String @map("tenant_id")
  sourceIssueId String @map("source_issue_id")
  targetIssueId String @map("target_issue_id")
  type          String // relates-to|duplicates|blocks
  createdBy     String? @map("created_by")
  createdAt     BigInt @map("created_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceIssue Issue  @relation("IssueRelationSource", fields: [sourceIssueId], references: [id], onDelete: Cascade)
  targetIssue Issue  @relation("IssueRelationTarget", fields: [targetIssueId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceIssueId, targetIssueId, type], map: "projects_issue_relations_unique")
  @@index([sourceIssueId])
  @@index([targetIssueId])
  @@map("projects_issue_relations")
}

model IssueDependency {
  id                String @id
  tenantId          String @map("tenant_id")
  predecessorIssueId String @map("predecessor_issue_id")
  successorIssueId  String @map("successor_issue_id")
  type              String @default("finish-to-start") // finish-to-start|start-to-start|finish-to-finish|start-to-finish
  lagMinutes        Int    @default(0) @map("lag_minutes")
  createdBy         String? @map("created_by")
  createdAt         BigInt @map("created_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  predecessor Issue  @relation("IssueDependencyPredecessor", fields: [predecessorIssueId], references: [id], onDelete: Cascade)
  successor   Issue  @relation("IssueDependencySuccessor", fields: [successorIssueId], references: [id], onDelete: Cascade)

  @@unique([tenantId, predecessorIssueId, successorIssueId], map: "projects_issue_dependencies_unique")
  @@index([predecessorIssueId])
  @@index([successorIssueId])
  @@map("projects_issue_dependencies")
}
