  --sidebar-foreground: oklch(0.285 0.016 259);
  --secondary-foreground: oklch(0.305 0.016 259);
  --accent-foreground: oklch(0.305 0.016 259);
  --sidebar-accent-foreground: oklch(0.305 0.016 259);
  --muted-foreground: oklch(0.545 0.019 258);

  /* ── Scrollbar ──
     Derived from --foreground with color-mix rather than hard-coded, so every
     theme in 876-themes.css (and any future one) inherits a correct thumb in
     both light and dark without redeclaring these two tokens. Deliberately
     low-contrast at rest: an internally-scrolling pane should read as content
     with an edge, not as a widget with a chrome rail down its side. */
  --876-scroll-thumb: color-mix(in oklab, var(--foreground) 20%, transparent);
  --876-scroll-thumb-hover: color-mix(
    in oklab,
    var(--foreground) 38%,
    transparent
  );

  /* ── Chip / hover neutrals ──
     Tinted to the same family, and pitched to stay visible on BOTH the
     near-white chrome and a pure-white card. */
  --muted: oklch(0.951 0.008 256);
  --secondary: oklch(0.951 0.008 256);
  --accent: oklch(0.951 0.008 256);
  --sidebar-accent: oklch(0.947 0.009 256);

  /* Enrich the green accent surface slightly vs the base 14/18% defaults. */
  --876-accent-surface: color-mix(in oklab, var(--876-green) 13%, transparent);
  --876-accent-surface-hover: color-mix(
    in oklab,
    var(--876-green) 17%,
    transparent
  );
}

.dark {
  /* Same three planes, same rule: chrome sits close to the canvas so their
     seam is a hairline, and the content surface carries the lift.
     Ladder: background 0.178 → canvas/card 0.198 → chrome 0.209 →
     surface 0.238 → popover 0.252. Monotonic, 258-hue slate. */
  --background: oklch(0.178 0.012 258);
  --876-chrome: oklch(0.209 0.013 258);
  --876-canvas: oklch(0.198 0.012 258);
  --876-surface: oklch(0.238 0.014 258);
  --sidebar: var(--876-chrome);
  --card: var(--876-canvas);
  --popover: oklch(0.252 0.014 258);

  /* Hairlines — cool-tinted glow against the slate ladder. */
  --border: oklch(0.85 0.02 258 / 10%);
  --876-surface-border: oklch(0.85 0.02 258 / 10%);
  --sidebar-border: oklch(0.85 0.02 258 / 10%);
  --border-strong: oklch(0.85 0.02 258 / 20%);
  --input: oklch(0.85 0.02 258 / 13%);

  /* Mirror of the light-mode softening: pure white body text glares against
     a dark slate card, so back it off a step. */
  --foreground: oklch(0.955 0.003 258);
  --card-foreground: oklch(0.955 0.003 258);
  --popover-foreground: oklch(0.955 0.003 258);
  --sidebar-foreground: oklch(0.955 0.003 258);
  --secondary-foreground: oklch(0.955 0.003 258);
  --accent-foreground: oklch(0.955 0.003 258);
  --sidebar-accent-foreground: oklch(0.955 0.003 258);
  --muted-foreground: oklch(0.735 0.015 258);

  --muted: oklch(0.272 0.014 258);
  --secondary: oklch(0.272 0.014 258);
  --accent: oklch(0.272 0.014 258);
  --sidebar-accent: oklch(0.278 0.014 258);

  /* Richer green stays vivid on the lighter dark surfaces. */
  --876-green: oklch(0.55 0.19 148);
}

/* ── Content surfaces ────────────────────────────────────────────────────
   876-surface: white card elevated off the slate canvas.
   Light: soft drop shadow. Dark: glassy raised edge + layered shadows. */
[class~='876-surface'] {
  background-color: var(--876-surface);
  border-color: var(--876-surface-border);
}

:where(:not(.dark)) [class~='876-surface'] {
  border-color: var(--876-surface-border);
  box-shadow:
    0 1px 2px oklch(0.28 0.02 259 / 4%),
    0 8px 24px oklch(0.28 0.02 259 / 5%);
}

:where(.dark) [class~='876-surface'] {
  border-color: oklch(1 0 0 / 6%);
  background-image: linear-gradient(
    180deg,
    oklch(1 0 0 / 3.5%),
    oklch(1 0 0 / 0%) 45%
  );
  box-shadow:
    0 1px 2px oklch(0 0 0 / 30%),
    0 10px 26px oklch(0 0 0 / 22%);
}

/* 876-card — the standard content card: 876-surface plus the xl radius and
   1px border every consumer used to re-type (`rounded-xl border`). Layered
   so composed utilities (border-dashed, rounded-*, hover:border-*, bg-*)
   still win over its declarations. */
@layer components {
  [class~='876-card'] {
    background-color: var(--876-surface);
    border: 1px solid var(--876-surface-border);
    border-radius: var(--radius-xl);
    box-shadow:
      0 1px 2px oklch(0.28 0.02 259 / 4%),
