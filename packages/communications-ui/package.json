{
  "name": "@876/communications-ui",
  "version": "0.1.0",
  "description": "Reusable React surfaces for the 876 communications product domain.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    "./panels/sender-list-panel": {
      "types": "./src/panels/sender-list-panel.tsx",
      "default": "./src/panels/sender-list-panel.tsx"
    },
    "./panels/domain-list-panel": {
      "types": "./src/panels/domain-list-panel.tsx",
      "default": "./src/panels/domain-list-panel.tsx"
    },
    "./panels/domain-records-panel": {
      "types": "./src/panels/domain-records-panel.tsx",
      "default": "./src/panels/domain-records-panel.tsx"
    },
    "./panels/template-list-panel": {
      "types": "./src/panels/template-list-panel.tsx",
      "default": "./src/panels/template-list-panel.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@876/communications": "workspace:*",
    "@876/core": "workspace:*",
    "@876/ui": "workspace:*"
  },
  "peerDependencies": {
    "next": "^16.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
