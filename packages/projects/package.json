{
  "name": "@876/projects",
  "version": "0.1.0",
  "description": "876 Projects product client and contracts.",
  "license": "UNLICENSED",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    },
    "./service": {
      "types": "./src/service-client.ts",
      "default": "./src/service-client.ts"
    },
    "./operator": {
      "types": "./src/operator.ts",
      "default": "./src/operator.ts"
    },
    "./layout-rules": {
      "types": "./src/layout-rules.ts",
      "default": "./src/layout-rules.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@876/core": "workspace:*",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
