      "types": "./src/request-list.tsx",
      "default": "./src/request-list.tsx"
    },
    "./request-list-rows": {
      "types": "./src/request-list-rows.ts",
      "default": "./src/request-list-rows.ts"
    },
    "./request-status": {
      "types": "./src/request-status.ts",
      "default": "./src/request-status.ts"
    },
    "./request-forms-list": {
      "types": "./src/request-forms-list.tsx",
      "default": "./src/request-forms-list.tsx"
    },
    "./request-record-shell": {
      "types": "./src/request-record-shell.tsx",
      "default": "./src/request-record-shell.tsx"
