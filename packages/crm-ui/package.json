{
  "name": "@876/crm-ui",
  "version": "0.1.0",
  "description": "Reusable React surfaces for the 876 CRM product domain.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    "./customer-list-shell": {
      "types": "./src/customer-list-shell.tsx",
      "default": "./src/customer-list-shell.tsx"
    },
    "./customer-list": {
      "types": "./src/customer-list.tsx",
      "default": "./src/customer-list.tsx"
