    "./request-composer": {
      "types": "./src/request-composer.tsx",
      "default": "./src/request-composer.tsx"
    },
    "./request-list-detail-shell": {
      "types": "./src/request-list-detail-shell.tsx",
      "default": "./src/request-list-detail-shell.tsx"
    },
    "./request-detail-card": {
