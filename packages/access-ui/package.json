{
  "name": "@876/access-ui",
  "version": "0.1.0",
  "description": "Reusable React surfaces for 876 app access profiles.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./app-access-panel": {
      "types": "./src/app-access-panel.tsx",
      "default": "./src/app-access-panel.tsx"
    },
    "./effective-permissions": {
      "types": "./src/effective-permissions.tsx",
      "default": "./src/effective-permissions.tsx"
    },
    "./app-access-summary": {
      "types": "./src/app-access-summary.tsx",
      "default": "./src/app-access-summary.tsx"
    },
    "./permission-matrix": {
      "types": "./src/permission-matrix.tsx",
      "default": "./src/permission-matrix.tsx"
    },
    "./entries": {
      "types": "./src/entries.ts",
      "default": "./src/entries.ts"
    },
    "./member-types": {
      "types": "./src/member-types.ts",
      "default": "./src/member-types.ts"
    },
    "./member-utils": {
      "types": "./src/member-utils.ts",
      "default": "./src/member-utils.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@876/core": "workspace:*",
    "@876/ui": "workspace:*"
  },
  "peerDependencies": {
    "next": "^16.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
