{
  "name": "@876/workspace",
  "version": "0.1.0",
  "description": "Typed clients for the 876 organization workspace control plane.",
  "license": "UNLICENSED",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./session": {
      "types": "./src/session.ts",
      "default": "./src/session.ts"
    },
    "./operator": {
      "types": "./src/operator.ts",
      "default": "./src/operator.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@876/account": "workspace:*",
    "@876/platform": "workspace:*",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
