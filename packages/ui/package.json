{
  "name": "@876/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons": {
      "types": "./src/icons.ts",
      "default": "./src/icons.ts"
    },
    "./category-icons": {
      "types": "./src/category-icons.tsx",
      "default": "./src/category-icons.tsx"
    },
    "./lib/utils": {
      "types": "./src/lib/utils.ts",
      "default": "./src/lib/utils.ts"
    },
    "./resource-row-link": {
      "types": "./src/resource-row-link.tsx",
      "default": "./src/resource-row-link.tsx"
    },
    "./sidebar-context": {
      "types": "./src/sidebar-context.ts",
      "default": "./src/sidebar-context.ts"
    },
    "./styles.css": "./src/styles.css",
    "./876.css": "./src/876.css",
    "./auth": {
      "types": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    "./onboarding": {
      "types": "./src/onboarding/index.ts",
      "default": "./src/onboarding/index.ts"
    },
    "./auth/provider-icons": {
      "types": "./src/auth/provider-icons.tsx",
      "default": "./src/auth/provider-icons.tsx"
    },
    "./logos/*": {
      "types": "./src/logos/*.tsx",
      "default": "./src/logos/*.tsx"
    },
    "./*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@876/core": "workspace:*",
    "@876/sdk": "workspace:*",
    "@876/work-ui": "workspace:*",
    "@base-ui/react": "1.7.0",
    "@heroicons/react": "2.2.0",
    "@tanstack/react-table": "^9.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "react-day-picker": "10.0.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.3",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "1.1.2"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3"
  }
}
