{
  "name": "@876/storage",
  "version": "0.1.0",
  "description": "Typed server-only clients for the 876 Storage service.",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./service": { "types": "./src/service.ts", "default": "./src/service.ts" },
    "./operator": { "types": "./src/operator.ts", "default": "./src/operator.ts" }
