  "scripts": { "test": "vitest run", "typecheck": "tsc --noEmit", "lint": "eslint .", "clean": "rm -rf .turbo" },
  "dependencies": { "@876/core": "workspace:*", "server-only": "0.0.1", "zod": "4.4.3" },
  "devDependencies": { "@types/node": "26.2.0", "typescript": "5.9.3", "vitest": "4.1.11" }
}
